# blerg-up.sh writes install/desktop/.env for you on first run — edit this
# only to change ports or optional keys. Never commit the real .env.
#
# On first run blerg-up.sh generates every secret below with a strong random
# value (openssl rand -hex 32 for the shared keys/tokens, openssl rand -base64
# 32 for BLERG_CORE_LOCAL_KEY) and writes them into .env for you — you don't
# need to fill these in yourself. If you hand-edit .env and leave one of these
# blank, a placeholder, or too short, blerg-up.sh refuses to start and tells
# you to run `./blerg-up.sh --regen-secrets` (which regenerates only the bad
# ones — everything else in .env is left alone).

# --- Host ports ---
# Change any of these (and re-run ./blerg-up.sh) if a default collides with
# something else already running on this machine. blerg-up.sh falls back to
# 8081/8082/8083 when these are left blank.
BLERG_PORT_CORE=
BLERG_PORT_BOARD=
BLERG_PORT_RUNNER=
# BLERG_BIND_ADDR=   # 0.0.0.0 exposes the stack to your LAN — see docker-compose.yml

# --- blerg-core (login / token issuance) ---
# Internal service key board/runner present on privileged core calls.
BLERG_CORE_INTERNAL_KEY=
# JWT signing key core uses to mint/verify its own tokens.
BLERG_CORE_LOCAL_KEY=
# Shared key a new component presents to self-register with core.
BLERG_CORE_REGISTER_KEY=
# Origins that GET /auth/refresh is allowed to redirect back to. An empty
# allowlist makes every refresh fail with 400, i.e. nobody can log in to board
# or runner at all. These MUST match the three ports above.
#
# blerg-up.sh regenerates both of these two vars from BLERG_PORT_* on every
# run, so a hand-edited port is picked up automatically — you normally don't
# need to touch these two lines yourself.
BLERG_CORE_ALLOWED_RETURN_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:8083
# Which token audience core mints for each of those origins. Without this every
# token is minted for "blerg-core", which board and runner both reject — the
# symptom is an endless redirect loop between the component and /auth/refresh.
BLERG_CORE_ORIGIN_AUDIENCES=http://localhost:8081=blerg-core,http://localhost:8082=blerg-board,http://localhost:8083=blerg-runner
# Failed POST /auth/login attempts allowed per client IP or per subject before
# a 429 (+Retry-After) kicks in, as <max>/<window>. 0/0 disables. Defaults to
# 10/5m even when this line is left commented out. The same limiter also
# guards POST /auth/password (a forced first-login password change).
# BLERG_CORE_LOGIN_RATE_LIMIT=10/5m
# BLERG_CORE_COOKIE_SECURE=false   # set by docker-compose.yml for the desktop stack; leave alone

# --- blerg-board (the board UI) ---
# Board has no password login of its own: humans sign in to blerg-core, which
# issues the token board accepts. See core/docs/CONFIG.md.
# Shared secret the board uses to mint its own service-to-service token.
BLERG_BOARD_SERVICE_KEY=
# AES-256 key (base64 of 32 random bytes: `openssl rand -base64 32`) that encrypts each board's
# automation token at rest. Distinct from every other key. Losing or changing it makes stored
# automation tokens unreadable (re-enter them in each board's settings) — back it up with .env.
BLERG_BOARD_SECRET_KEY=

# --- board <-> runner contract ---
# Shared key the board presents to the runner on every call, and the runner
# checks. One value, used by both services.
BLERG_RUNNER_KEY=

# --- blerg-runner (the session runner) ---
# Auth token the host blerg-runner daemon presents on /ws/daemon.
# Use the SAME value when you start the host daemon (see blerg-up.sh output).
BLERG_RUNNER_DAEMON_TOKEN=
# Root directory the host daemon may open repositories under. Defaults to
# $HOME/repositories when left commented out. First-run default only: once
# the folder is changed from the app, the daemon's saved choice wins (see
# DAEMON.md, "Changing the repos folder later").
# BLERG_RUNNER_REPOS_ROOT=
# Where the launch sheet's Claude model list comes from. Left commented out,
# the runner fetches the public Claude Code model catalog every 6 h. Uncomment
# it EMPTY on an offline machine to use the list built into the runner.
# BLERG_RUNNER_MODEL_CATALOG_URL=
# Always-on plugins: the GitHub owner/repo marketplaces an account may pick
# plugins from (comma-separated; * = any). Left commented out, only
# anthropics/claude-plugins-official is allowed. Set core's and the runner's to
# the same value. The runner's is only used by a cluster runtime.
# BLERG_CORE_PLUGIN_MARKETPLACES=
# BLERG_RUNNER_PLUGIN_MARKETPLACES=

# --- Optional: admission gate (usually left blank) ---
# NOT how coding sessions authenticate. This only turns on the board's optional
# admission gate (an LLM adjudicates card writes) using a metered API key.
# Leave blank to keep writes ungated for local testing.
ANTHROPIC_API_KEY=

# --- Claude auth for coding sessions: HOST daemon, NOT this file ---
# Agent sessions run on the blerg-runner daemon you start on the HOST, and they
# use your Claude Code SUBSCRIPTION, not an API key:
#   run `claude setup-token` once, then start the daemon with
#   CLAUDE_CODE_OAUTH_TOKEN set (or with your `claude` CLI already logged in).
# That token is a host-daemon env var — it does NOT belong in this .env, but is
# listed here (commented out) as a reminder of its name.
# CLAUDE_CODE_OAUTH_TOKEN=
