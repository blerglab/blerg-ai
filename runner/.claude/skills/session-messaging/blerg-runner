def _fetch_fail(msg):
    _eprint(f"blerg-runner fetch: {msg}")
    sys.exit(1)


def _fetch_http_error(exc, url):
    body = exc.read()
    detail, eid = _reply_detail(body)
    where = _http_where(exc.code, url, eid)
    if _token_revoked(exc.code, body):
        return f"{TOKEN_REVOKED_HINT} ({where})"
    if exc.code in (401, 403):
        return f"not allowed to fetch from this session (the session token was refused) ({where})"
    if exc.code == 404:
        return f"attachment not found ({where})"
    if exc.code == 410:
        return f"the runner no longer has this file's bytes; ask the user to attach it again ({where})"
    return f"{detail or 'no reason given'} ({where})"


def _fetch_request(path, timeout=120, fatal=True):
    """Open a GET. On failure: exit with a one-line error (fatal), or raise RuntimeError(message)."""
    url = f"{SERVER_HTTP}{path}"
    req = urllib.request.Request(url, headers=_headers(), method="GET")
    try:
        return _open(req, timeout=timeout)
    except urllib.error.HTTPError as exc:
        msg = _fetch_http_error(exc, url)
    except _NET_ERRORS as exc:
        msg = _conn_failure(url, exc)
    if fatal:
        _fetch_fail(msg)
    raise RuntimeError(msg)


def _files_fail(cmd, msg):
    _eprint(f"blerg-runner {cmd}: {msg}")
    sys.exit(1)


def _session_files():
    """The files this session published (newest first) and the session's slot usage."""
    sid = urllib.parse.quote(SESSION_ID, safe="")
