# The agent reads this (diff --help and the top-level usage). Its first line is the line the session
# guide and the managed CLAUDE.md block carry (daemon/claudecode.go diffGuideLine).
DIFF_LINE = "To show the person what you changed, `blerg-runner diff <range>` posts a diff they can open."

DIFF_GUIDE = DIFF_LINE + """

  blerg-runner diff                      everything not committed: staged, unstaged and new files
  blerg-runner diff --staged             what is staged for the next commit
  blerg-runner diff main..HEAD           a range (A..B or A...B): its net change
  blerg-runner diff 1a2b3c4 5d6e7f8      commits, each with its own patch, in the order given
  blerg-runner diff HEAD -- src/ docs/   any of these, limited to paths (after --)
  blerg-runner diff main..HEAD --title "Retry the upload"

It runs git in the current folder and publishes the patch as <title>.diff: a card in the chat that
opens the app's diff viewer (file list, unified or side by side). The default title says what was
compared; the same title again makes a new version. Binary files are listed with their size, never
embedded. Nothing the repository's own settings name is run (no hooks, external diff tools, text
conversions or filters). The patch counts against the per-file limit like any published file; a
diff over it is refused, with both sizes: narrow it with paths, or a shorter range.
"""

DIFF_MAX_COMMITS = 50
DIFF_MAX_NEW_FILES = 200
DIFF_GIT_TIMEOUT = 120
# The app's diff viewer shows a patch up to this size; a larger one is a download.
DIFF_VIEW_MAX = 2 * MIB
# Settings that make git run something, or change what the patch looks like, overridden on every
# call (the command line beats the repository's config). Filters are blanked per driver, below.
_GIT_SAFE_CONFIG = (
    ("core.hooksPath", "/dev/null"), ("core.fsmonitor", "false"), ("credential.helper", ""),
    ("protocol.allow", "never"), ("protocol.ext.allow", "never"), ("log.showSignature", "false"),
    ("core.pager", "cat"), ("color.ui", "false"), ("core.quotePath", "false"),
)
_GIT_DIFF_FLAGS = (
    "--no-ext-diff", "--no-textconv", "--no-color", "-U3", "--src-prefix=a/", "--dst-prefix=b/",
    "--no-relative", "--full-index", "--submodule=short", "-O/dev/null",
)
# git's own environment that may stay: where the repository is. The rest (GIT_EXTERNAL_DIFF,
# GIT_CONFIG_PARAMETERS, GIT_EXEC_PATH, GIT_PAGER, ...) is dropped.
_GIT_KEEP_ENV = {
    "GIT_DIR", "GIT_WORK_TREE", "GIT_COMMON_DIR", "GIT_INDEX_FILE", "GIT_OBJECT_DIRECTORY",
    "GIT_ALTERNATE_OBJECT_DIRECTORIES", "GIT_CEILING_DIRECTORIES", "GIT_DISCOVERY_ACROSS_FILESYSTEM",
    "GIT_CONFIG_NOSYSTEM", "GIT_CONFIG_GLOBAL", "GIT_CONFIG_SYSTEM",
}
_HUNK_RE = re.compile(rb"^@@ -\d+(?:,(\d+))? \+\d+(?:,(\d+))? @@")
_ZERO_ID_RE = re.compile(r"0+")


class _DiffError(Exception):
    """A diff that cannot be made, in words."""


class _Git:
    """git, run without a shell in one folder, with nothing the repository names executed."""

    def __init__(self, cwd):
        self.cwd = cwd
        self.env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_") or k in _GIT_KEEP_ENV}
        self.env.update(GIT_TERMINAL_PROMPT="0", GIT_NO_LAZY_FETCH="1", GIT_OPTIONAL_LOCKS="0",
                        GIT_PAGER="cat", PAGER="cat", LC_ALL="C")
        self.config = list(_GIT_SAFE_CONFIG)

    def argv(self, args):
        out = ["git", "--no-pager"]
        for key, value in self.config:
            out += ["-c", f"{key}={value}"]
        return out + list(args)

    def run(self, args, ok=(0,), stdin=None, cwd=None):
        """(exit code, stdout bytes) of a short git call; _DiffError with git's words otherwise."""
        try:
            proc = subprocess.run(self.argv(args), cwd=cwd or self.cwd, env=self.env, input=stdin,
                                  stdin=None if stdin is not None else subprocess.DEVNULL,
                                  capture_output=True, timeout=DIFF_GIT_TIMEOUT)
        except FileNotFoundError:
            raise _DiffError("git is not installed here")
        except subprocess.TimeoutExpired:
            raise _DiffError(f"git took longer than {DIFF_GIT_TIMEOUT} s")
        if proc.returncode not in ok:
            raise _DiffError(_git_words(proc.stderr) or f"git exited {proc.returncode}")
        return proc.returncode, proc.stdout

    def stream(self, args, patch, ok=(0,), cwd=None):
        """Run git and add its output to patch (which keeps at most its limit, counting the rest)."""
        with tempfile.TemporaryFile() as err:
            try:
                proc = subprocess.Popen(self.argv(args), cwd=cwd or self.cwd, env=self.env,
                                        stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=err)
            except FileNotFoundError:
                raise _DiffError("git is not installed here")
            timer = threading.Timer(max(1.0, patch.deadline - time.monotonic()), proc.kill)
            timer.start()
            try:
                while True:
                    chunk = proc.stdout.read(1 << 16)
                    if not chunk:
                        break
                    patch.add(chunk)
                code = proc.wait()
            finally:
                timer.cancel()
                proc.stdout.close()
            if time.monotonic() >= patch.deadline:
                raise _DiffError(f"git took longer than {DIFF_GIT_TIMEOUT} s; narrow the diff with paths")
            if code not in ok:
                err.seek(0)
                raise _DiffError(_git_words(err.read(4096)) or f"git exited {code}")

    def neutralise_filters(self):
        """Blank every filter driver the config names: git would run its clean command on a
        working-tree file it compares."""
        code, out = self.run(["config", "-z", "--name-only", "--get-regexp", r"^filter\."], ok=(0, 1))
        names = set()
        for key in out.decode("utf-8", "surrogateescape").split("\0"):
            if key.count(".") >= 2:
                names.add(key[len("filter."):key.rindex(".")])
        for name in sorted(names):
            if "=" in name or "\n" in name:
                raise _DiffError(f"the repository names a filter driver git cannot be told to skip ({name!r})")
            self.config += [(f"filter.{name}.{k}", v) for k, v in
                            (("clean", ""), ("smudge", ""), ("process", ""), ("required", "false"))]


def _git_words(stderr):
    lines = [ln.strip() for ln in stderr.decode("utf-8", "replace").splitlines() if ln.strip()]
    lines = [ln[len("fatal: "):] if ln.startswith("fatal: ") else ln for ln in lines]
    return _cut(_redact("; ".join(lines[:3])), 300)


class _Patch:
    """The bytes of the patch, kept up to limit; past it only counted."""

    def __init__(self, limit):
        self.limit = limit
        self.data = bytearray()
        self.size = 0
        self.deadline = time.monotonic() + DIFF_GIT_TIMEOUT

    def add(self, chunk):
        self.size += len(chunk)
        if self.size <= self.limit:
            self.data += chunk

    def separate(self):
        """End the output so far with a newline before the next git output (a commit) follows."""
        if self.data and not self.over and not self.data.endswith(b"\n"):
            self.add(b"\n")

    @property
    def over(self):
        return self.size > self.limit


def _unquote_git_path(s):
    """A path as git prints it: C-quoted ("a/x\\ty") or plain."""
    if not (s.startswith('"') and s.endswith('"') and len(s) >= 2):
        return s
    raw = s[1:-1]
    out = bytearray()
    i = 0
    simple = {"n": 10, "t": 9, '"': 34, "\\": 92, "a": 7, "b": 8, "f": 12, "r": 13, "v": 11}
    while i < len(raw):
        c = raw[i]
        if c == "\\" and i + 1 < len(raw):
            n = raw[i + 1]
            if n in simple:
                out.append(simple[n])
                i += 2
                continue
            if re.fullmatch(r"[0-7]{3}", raw[i + 1:i + 4]):
                out.append(int(raw[i + 1:i + 4], 8))
                i += 4
                continue
        out += c.encode("utf-8", "surrogateescape")
        i += 1
    return out.decode("utf-8", "replace")


def _header_path(rest):
    """The new-side path of `diff --git <rest>`: b/<p> of `a/<p> b/<p>` (both plain or quoted)."""
    if rest.startswith('"'):
        m = re.match(r'"(?:[^"\\]|\\.)*"', rest)
        if m:
            tail = rest[m.end():].lstrip(" ")
            p = _unquote_git_path(tail) if tail.startswith('"') else tail
            return p[2:] if p.startswith("b/") else p
    n = len(rest)
    if n % 2 == 1 and rest.startswith("a/"):
        half = (n - 1) // 2
        a, b = rest[:half], rest[half + 1:]
        if b.startswith("b/") and a[2:] == b[2:]:
            return b[2:]
    i = rest.rfind(" b/")
    return rest[i + 3:] if i >= 0 else rest


def _diff_stats(data):
    """(paths in order, unique; lines added; lines deleted) of a unified patch."""
    paths, seen = [], set()
    adds = dels = 0
    old = new = 0
    for line in bytes(data).split(b"\n"):
        if old > 0 or new > 0:
            if line.startswith(b"+"):
                adds += 1
                new -= 1
            elif line.startswith(b"-"):
                dels += 1
                old -= 1
            elif line.startswith(b" ") or line == b"":
                old -= 1
                new -= 1
            elif line.startswith(b"\\"):
                pass
            else:
                old = new = 0
            continue
        if line.startswith(b"diff --git "):
            p = _header_path(line[len(b"diff --git "):].decode("utf-8", "replace"))
            if p not in seen:
                seen.add(p)
                paths.append(p)
            continue
        m = _HUNK_RE.match(line)
        if m:
            old = int(m.group(1)) if m.group(1) is not None else 1
            new = int(m.group(2)) if m.group(2) is not None else 1
    return paths, adds, dels


def _note_binary_sizes(git, data, top):
    """The patch with each `Binary files ... differ` line followed by its sizes:
    `(binary, 5 -> 7 bytes)`, `(binary, 10 bytes)` for an added or deleted file. A size comes from
    the object (the --full-index ids), else, for a working-tree file, from the file itself."""
    lines = bytes(data).split(b"\n")
    pending = []  # (line index, old id, new id, path)
    ids = {}
    path, old_id, new_id = None, None, None
    for i, line in enumerate(lines):
        if line.startswith(b"diff --git "):
            path = _header_path(line[len(b"diff --git "):].decode("utf-8", "replace"))
            old_id = new_id = None
        elif line.startswith(b"rename to ") or line.startswith(b"copy to "):
            path = _unquote_git_path(line.split(b" to ", 1)[1].decode("utf-8", "replace"))
        elif line.startswith(b"index ") and b".." in line:
            ab = line[len(b"index "):].split(b" ", 1)[0].decode("ascii", "replace")
            old_id, _, new_id = ab.partition("..")
        elif line.startswith(b"Binary files ") and line.endswith(b" differ") and path is not None:
            pending.append((i, old_id, new_id, path))
            for oid in (old_id, new_id):
                if oid and not _ZERO_ID_RE.fullmatch(oid):
                    ids[oid] = None
    if not pending:
        return data
    if ids:
        try:
            _, out = git.run(["cat-file", "--batch-check=%(objectname) %(objectsize)"],
                             stdin=("\n".join(ids) + "\n").encode())
            for row in out.decode("ascii", "replace").splitlines():
                parts = row.split()
                if len(parts) == 2 and parts[1].isdigit():
                    ids[parts[0]] = int(parts[1])
        except _DiffError:
            pass

    def size_of(oid, worktree_path=None):
        if not oid or _ZERO_ID_RE.fullmatch(oid):
            return None
        if ids.get(oid) is not None:
            return ids[oid]
        if worktree_path is not None:
            try:
                return os.lstat(os.path.join(top, worktree_path)).st_size
            except OSError:
                return None
        return None

    for i, old_id, new_id, p in pending:
        added = old_id is not None and _ZERO_ID_RE.fullmatch(old_id or "x") is not None
        deleted = new_id is not None and _ZERO_ID_RE.fullmatch(new_id or "x") is not None
        before = None if added else size_of(old_id)
        after = None if deleted else size_of(new_id, p)
        if before is not None and after is not None:
            note = f"(binary, {before} -> {after} bytes)"
        elif after is not None or before is not None:
            note = f"(binary, {after if after is not None else before} bytes)"
        else:
            continue
        lines[i] = lines[i] + b" " + note.encode()
    return b"\n".join(lines)


def _resolve_commit(git, rev):
    if not rev or rev.startswith("-"):
        raise _DiffError(f"{rev!r} is not a commit (a revision cannot start with '-')")
    try:
        _, out = git.run(["rev-parse", "--verify", "--quiet", "--end-of-options", rev + "^{commit}"])
    except _DiffError:
        raise _DiffError(f"{rev!r} is not a commit in this repository")
    sha = out.decode().strip()
    if not re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", sha):
        raise _DiffError(f"{rev!r} is not a commit in this repository")
    return sha


def _diff_slug(title):
    slug = re.sub(r"[\W_]+", "-", title.lower()).strip("-")
    return slug[:60].strip("-") or "changes"


def _make_diff(git, revs, staged, worktree, paths, limit):
    """(patch bytes or None when over the limit, its full size, default title, notes)."""
    try:
        _, top = git.run(["rev-parse", "--show-toplevel"])
    except _DiffError as exc:
        if "not a git repository" in str(exc):
            raise _DiffError("not inside a git repository (run it in the repository's folder)")
        raise
    top = top.decode("utf-8", "surrogateescape").strip()
    git.neutralise_filters()
    patch = _Patch(limit)
    notes = []
    tail = ["--", *paths] if paths else []
    flags = list(_GIT_DIFF_FLAGS)
    ranges = [r for r in revs if ".." in r]
    if staged:
        title = "Staged changes"
        git.stream(["diff", "--cached", *flags, *tail], patch)
    elif ranges:
        if len(revs) != 1:
            raise _DiffError("give one range (A..B), or commits, not both")
        rng = revs[0]
        sep = "..." if "..." in rng else ".."
        left, _, right = rng.partition(sep)
        if sep in right:
            raise _DiffError(f"{rng!r} is not a range (A..B or A...B)")
        a = _resolve_commit(git, left or "HEAD")
        b = _resolve_commit(git, right or "HEAD")
        title = rng
        git.stream(["diff", *flags, "--end-of-options", f"{a}{sep}{b}", *tail], patch)
    elif revs:
        if len(revs) > DIFF_MAX_COMMITS:
            raise _DiffError(f"at most {DIFF_MAX_COMMITS} commits at once, got {len(revs)}")
        shas = [_resolve_commit(git, r) for r in revs]
        title = " ".join(revs) if len(revs) <= 3 else f"{revs[0]} and {len(revs) - 1} more"
        fmt = "--format=commit %H%nAuthor: %an%nDate:   %aI%n%n%w(0,4,4)%B"
        for sha in shas:
            patch.separate()
            git.stream(["show", fmt, *flags, "--diff-merges=first-parent", "--no-show-signature",
                        "--end-of-options", sha, *tail], patch)
    else:
        title = "Uncommitted changes"
        code, _ = git.run(["rev-parse", "--verify", "--quiet", "HEAD^{commit}"], ok=(0, 1))
        if code == 0:
            base = "HEAD"
        else:
            _, empty = git.run(["hash-object", "-t", "tree", "/dev/null"])
            base = empty.decode().strip()
        git.stream(["diff", *flags, "--end-of-options", base, *tail], patch)
        _, listed = git.run(["ls-files", "-z", "--others", "--exclude-standard", "--full-name", *tail])
        new_files = [p for p in listed.decode("utf-8", "surrogateescape").split("\0") if p and not p.endswith("/")]
        if len(new_files) > DIFF_MAX_NEW_FILES:
            notes.append(f"{len(new_files) - DIFF_MAX_NEW_FILES} more new files are not in it "
                         f"(at most {DIFF_MAX_NEW_FILES}; name paths after -- to pick)")
            new_files = new_files[:DIFF_MAX_NEW_FILES]
        for p in new_files:
            git.stream(["diff", "--no-index", *flags, "--", "/dev/null", p], patch, ok=(0, 1), cwd=top)
    if patch.over:
        return None, patch.size, title, notes
    return _note_binary_sizes(git, patch.data, top), patch.size, title, notes


def _diff_fail(msg):
    _eprint(f"blerg-runner diff: {msg}")
    sys.exit(1)


def publish_diff(revs, staged=False, worktree=False, paths=(), title=None, fail=_diff_fail):
    """Make the diff, publish it as <slug>.diff and return (the server's reply, title, paths,
    adds, dels). fail(msg) is called (and must exit) when it cannot be made or published."""
    if (staged or worktree) and revs:
        fail("--staged and --worktree compare the working folder; give them without commits or ranges")
    if staged and worktree:
        fail("give --staged or --worktree, not both")
    limit, total, used = _publish_limits()
    git = _Git(os.getcwd())
    try:
        data, size, default_title, notes = _make_diff(git, list(revs), staged, worktree, list(paths), limit)
    except _DiffError as exc:
        fail(str(exc))
    title = (title or "").strip() or default_title
    name = _diff_slug(title) + ".diff"
    if data is None:
        fail(f"the diff is {_fmt_size(size)}; this runner takes at most {_fmt_limit(limit)} per file "
             "(narrow it with paths after --, or a shorter range)")
    if not data.strip():
        fail("no changes to show" + (" in those paths" if paths else ""))
    size = len(data)
    if size > limit:
        fail(f"the diff is {_fmt_size(size)}; this runner takes at most {_fmt_limit(limit)} per file "
             "(narrow it with paths after --, or a shorter range)")
    if total is not None and used + size > total:
        fail(f"the diff is {_fmt_size(size)}, and this session's published files would go over their "
             f"{_fmt_limit(total)} total ({_fmt_size(used)} used); delete one first "
             "(blerg-runner files lists them; blerg-runner unpublish <name> frees a slot)")
    files, adds, dels = _diff_stats(data)
    fd, tmp = tempfile.mkstemp(suffix=".diff")
    try:
        with os.fdopen(fd, "wb") as fh:
            fh.write(data)
        out = _upload_artifact(tmp, name, size, limit, fail)
    finally:
        os.unlink(tmp)
    for note in notes:
        print(f"Note: {note}")
    return out, title, files, adds, dels, size


def cmd_diff(revs, staged=False, worktree=False, paths=(), title=None):
    out, title, files, adds, dels, size = publish_diff(revs, staged, worktree, paths, title)
    n = len(files)
    head = f"Published diff {title}"
    version = out.get("version")
    if isinstance(version, int) and version > 1:
        head += f" as v{version}"
    head += f" · {n} file{'' if n == 1 else 's'} · +{adds} −{dels}"
    view = out.get("view", "none")
    if view == "none":
        print(f"{head} — no in-app preview (download only)")
    elif view == "diff" and size > DIFF_VIEW_MAX:
        print(f"{head} — too large for the app's diff viewer (over {_fmt_limit(DIFF_VIEW_MAX)}): "
              "the person can download it")
    else:
        print(f"{head} — viewable in the app")
    if out.get("url"):
        print(f"Link: {out['url']}")


# ── topic (mark a piece of work for the History tab) ─────────────────────────

# The agent reads this (topic --help and the top-level usage). Its first paragraph is the line the
# session guide and the managed CLAUDE.md block carry (daemon/claudecode.go topicGuideLine).
TOPIC_GUIDE = """\
When you start a piece of work the user asked for that takes several steps, run
`blerg-runner topic "<short imperative title>"`; when it is finished or dropped,
`blerg-runner topic --done "<one-line outcome>"`, and when the work landed commits, pass them:
`--commit <sha>`. One topic at a time; not for a quick question, and not from a subagent.

Starting a topic ends the one that is open. The person's History tab lists each topic with the files
it published, the subagents it ran, its outcome and its commits (a chip per sha, a link when the
session's repository is known). A title is at most 80 characters, an outcome 200; --commit takes a
sha of 7 to 40 hex characters, repeated or comma-separated, at most 50.
"""

TOPIC_MAX_COMMITS = 50
CHECKLIST_MAX_COMMITS = 20
_SHA_RE = re.compile(r"[0-9a-fA-F]{7,40}")


def _topic_fail(msg):
    _eprint(f"blerg-runner topic: {msg}")
    sys.exit(1)


def _topic_commits(given, fail=None, limit=None, what="topic"):
    """The --commit values (each one sha or a comma-separated list), in order; refuses a bad one."""
    fail = fail or _topic_fail
    limit = limit or TOPIC_MAX_COMMITS
    shas = []
    for value in given:
        for piece in value.split(","):
            piece = piece.strip()
            if not piece:
                continue
            if not _SHA_RE.fullmatch(piece):
                fail(f"--commit {piece!r} is not a commit sha (7 to 40 hex characters)")
            shas.append(piece)
    if not shas:
        fail("give a commit sha with --commit (7 to 40 hex characters)")
    if len(shas) > limit:
        fail(f"at most {limit} commits on one {what}, got {len(shas)}")
    return shas


def cmd_topic(title, done, commits=None):
    """Start a topic (title) or close the open one (done: the outcome, possibly empty), with the
    commits the work landed (done only)."""
    if done is not None and title:
        _topic_fail("give a title to start a topic, or --done to close the open one, not both")
    if commits and done is None:
        _topic_fail("--commit goes with --done: name the commits when the topic is finished")
    if done is None and not (title or "").strip():
        _topic_fail('give a title: blerg-runner topic "<short imperative title>"')
    body = {"action": "done", "outcome": done} if done is not None else {"action": "start", "title": title}
    if commits:
        body["commits"] = [{"sha": s} for s in _topic_commits(commits)]
    url = f"{SERVER_HTTP}/api/sessions/{urllib.parse.quote(SESSION_ID, safe='')}/topics"
    req = urllib.request.Request(url, data=json.dumps(body).encode(), headers=_headers(), method="POST")
    try:
        with _open(req, timeout=30) as resp:
            ctype = resp.headers.get("Content-Type", "")
            raw = resp.read()
    except urllib.error.HTTPError as exc:
        _topic_fail(_http_failure(exc.code, url, exc.read()))
    except _NET_ERRORS as exc:
        _topic_fail(_conn_failure(url, exc))
    if "application/json" not in ctype:
        _topic_fail("this runner server does not know topics yet; nothing was recorded")
    reply = json.loads(raw or b"{}")
    if done is not None:
        line = f"Topic done: {reply.get('title', '')}"
        if reply.get("outcome"):
            line += f" ({reply['outcome']})"
        n = len(reply.get("commits") or [])
        if n:
            line += f" · {n} commit{'' if n == 1 else 's'}"
        print(line)
        return
    line = f"Topic started: {reply.get('title', title)}"
    closed = reply.get("closed")
    if closed:
        line += f" (closed: {closed.get('title', '')})"
    print(line)


# ── checklist, pin, unpin (what the session works through) ─────────────────────

# The agent reads these (checklist --help, pin --help and the top-level usage). WORK_LINE is the
