def cmd_request_plugin(name, reason):
    """Queue a human approval; never call an installer or write account settings."""
    parts = name.split("@")
    valid_name = bool(re.fullmatch(r"[a-z0-9][a-z0-9._-]{0,63}", parts[0]))
    if len(parts) == 2:
        source = parts[1]
        valid_name = valid_name and bool(re.fullmatch(r"[A-Za-z0-9._-]{1,39}/[A-Za-z0-9._-]{1,100}", source))
        valid_name = valid_name and not source.startswith((".", "-")) and source.split("/")[-1] not in (".", "..")
    elif len(parts) != 1:
        valid_name = False
    if not valid_name:
        _eprint("blerg-runner: use a plugin name or plugin@owner/repo from an allowed marketplace")
        sys.exit(1)
    if not reason.strip() or len(reason.encode("utf-8")) > 2000 or any((ord(c) < 32 and c not in "\n\t") or 127 <= ord(c) <= 159 for c in reason):
        _eprint("blerg-runner: give a reason of 1-2000 UTF-8 bytes without control characters")
        sys.exit(1)
    path = "/api/sessions/" + urllib.parse.quote(SESSION_ID, safe="") + "/plugin-requests"
    data = json.dumps({"name": name, "reason": reason}).encode()
    req = urllib.request.Request(SERVER_HTTP + path, data=data, headers=_headers(), method="POST")
    try:
        with _open(req, timeout=30, allow_redirects=False) as resp:
            raw = resp.read(65537)
        if len(raw) > 65536:
            raise ValueError("oversized reply")
        result = json.loads(raw)
        if not isinstance(result, dict) or result.get("state") != "pending" or not isinstance(result.get("id"), str) or not re.fullmatch(r"[A-Za-z0-9_-]{1,100}", result["id"]):
            raise ValueError("invalid reply")
    except urllib.error.HTTPError as exc:
        _eprint("blerg-runner: plugin request was refused (HTTP " + str(exc.code) + "); check the allowed marketplace and session access")
        sys.exit(1)
    except (_NET_ERRORS + (ValueError, TypeError)):
        _eprint("blerg-runner: plugin request could not be queued; no installation was requested")
        sys.exit(1)
    print("Plugin request " + result["id"] + " is waiting for human approval; nothing is installed.")


