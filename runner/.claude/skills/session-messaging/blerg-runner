def _board_configured():
    return bool((BOARD_GATEWAY_URL or SERVER_HTTP) and BOARD_ID and BOARD_TOKEN)


# Set when the board commands go through the runner with the session token (no launch-time board
# credential): every call names its board and the runner checks the session's level for it.
BOARD_VIA_SESSION = False


def _session_board_available():
    return bool(SERVER_HTTP and SESSION_ID and _session_token())


def _board_noop_notice():
    print(
        "blerg-runner: board not configured "
        "(BLERG_RUNNER_SERVER_HTTP/BLERG_RUNNER_BOARD_ID/BLERG_RUNNER_BOARD_TOKEN absent) "
        "— skipping.",
        file=sys.stderr,
    )


def _session_board_request(method, path, payload=None, timeout=30):
    """A board request to the runner with the session's own token: board-access (the session's
    boards and levels) or board-tools (one board tool call, checked against the level). The board
    credential stays in the runner; nothing here ever holds one."""
    url = f"{SERVER_HTTP}/api/sessions/{urllib.parse.quote(SESSION_ID, safe='')}/{path}"
    data = json.dumps(payload).encode() if payload is not None else None
    req = urllib.request.Request(url, data=data, method=method, headers={
        "Authorization": "Bearer " + _session_token(), "Content-Type": "application/json", "Accept": "application/json"})
    try:
        with _open(req, timeout=timeout, allow_redirects=False) as resp:
            raw = resp.read(2 * 1024 * 1024 + 1)
        if len(raw) > 2 * 1024 * 1024:
            _board_refused("board reply exceeds 2 MiB")
        value = json.loads(raw)
        if not isinstance(value, dict):
            _board_refused("invalid board reply")
        return value
    except urllib.error.HTTPError as exc:
        _eprint(f"blerg-runner: {_http_failure(exc.code, url, exc.read(65536))}")
        sys.exit(1)
    except _NET_ERRORS as exc:
        _eprint(f"blerg-runner: {_conn_failure(url, exc)}")
        sys.exit(1)
    except (ValueError, RecursionError):
        _board_refused("invalid board reply")


def _session_boards():
    reply = _session_board_request("GET", "board-access")
    boards = reply.get("boards")
    if not isinstance(boards, list) or not all(isinstance(b, dict) and isinstance(b.get("id"), str) for b in boards):
        _board_refused("invalid board access reply")
    return reply.get("configured") is True, boards


def _use_session_board(board_arg):
    """Switch the board commands to the runner and pick their board: the one named (id or name),
    else BLERG_RUNNER_BOARD_ID, else the session's only board. Returns the board id."""
    global BOARD_VIA_SESSION, BOARD_ID
    BOARD_VIA_SESSION = True
    configured, boards = _session_boards()
    if not configured:
        _board_refused("board access is not configured on this runner")
    want = board_arg or BOARD_ID
    if want:
        named = [b["id"] for b in boards if b["id"] == want] or [b["id"] for b in boards if b.get("name") == want]
        if len(named) > 1:
            _board_refused(f'more than one board is named "{want}"; use its id')
        BOARD_ID = named[0] if named else want  # the runner refuses a board this session has no access to
        return BOARD_ID
    if len(boards) == 1:
        BOARD_ID = boards[0]["id"]
        return BOARD_ID
    if not boards:
        _board_refused("this session has no board access. Ask the person to give it in the session's Permissions "
                       "(Boards), or propose a card with `blerg-runner ticket file`, which asks them")
    names = ", ".join(f"{b.get('name') or b['id']} ({b['id']})" for b in boards)
    _board_refused(f"this session can use several boards ({names}); name one, e.g. `blerg-runner board show <id>`, "
                   "or set BLERG_RUNNER_BOARD_ID")


def cmd_board_access():
    """The session's boards and levels (the person sets them in the session's Permissions)."""
    if BOARD_GATEWAY_URL and BOARD_ID and BOARD_TOKEN and not _session_board_available():
        print(f"{BOARD_ID}  (chosen at launch)")
        return
    if not _session_board_available():
        _noop_notice()
        return
    configured, boards = _session_boards()
    if not configured:
        print("Board access is not configured on this runner.")
        return
    if not boards:
        print("No board access: every board is at propose (search and `ticket file`, which asks the person).")
        return
    for b in boards:
        line = f"{b.get('name') or b['id']}  ({b['id']})  {b.get('level', '?')}"
        if b.get("parent_level"):
            # A started session: its level is capped by the session that started it.
            line += f"  (capped by the session that started you, which has {b['parent_level']})"
        print(line)


