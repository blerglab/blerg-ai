# Stage 1: Build Go binary
FROM golang:1.27-bookworm@sha256:69a7b9788769bec032d238959b61854e9ae87f57be9029ec04e9885fabf99195 AS go-builder
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags "-X main.version=${VERSION}" -o blerg-runner-daemon ./cmd/daemon

# Stage 2: Final image
# Use base (not static) because PTY may need libc
FROM gcr.io/distroless/base:nonroot@sha256:0896741ba5bafd3ac87ea025a5f578952f2d238ddc3614cb368acc983a687aa2
WORKDIR /app
COPY --from=go-builder /build/blerg-runner-daemon ./blerg-runner-daemon
ENTRYPOINT ["./blerg-runner-daemon"]
