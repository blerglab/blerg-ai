# The exit code of `session watch` and `session wait` when the child failed for good: it ended in
# error, or its engine runtime reported that it has stopped. It takes no more turns; the reason is
# printed. An "error" the child can recover from is not a failure: the watch keeps waiting.
SESSION_FAILED_EXIT = 4


def _session_failed(reason):
    """Say why the child failed and exit with SESSION_FAILED_EXIT."""
    reason = " ".join(str(reason or "").split())
    _session_print("the session failed" + (f": {reason}" if reason else ""))
    sys.stdout.flush()
    sys.exit(SESSION_FAILED_EXIT)


# The end reasons of a child that failed for good. Any other "error" (a turn's engine error, a daemon
# that dropped its connection) can be revived by the child's daemon, so a watch keeps waiting.
_FAILED_END_REASONS = ("process_failed", "start_failed")


def _child_failed(info):
    """The reason a child has failed for good (it ended in error), else None."""
    if info.get("lifecycle") == "error" and info.get("end_reason") in _FAILED_END_REASONS:
        return info.get("error_reason") or info.get("end_reason")
    return None


def _runtime_stopped(events):
    """The message of an event saying the child's engine runtime has stopped for good, else None."""
    for ev in events:
        p = ev.get("payload") or {}
        if ev.get("kind") == "error" and isinstance(p, dict) and p.get("code") == "runtime_stopped":
            return p.get("message") or "its runtime stopped"
    return None


def _watch_print(events, asks, answered):
    """Print what the events say; True when one of them ended the turn."""
    turn_done = False
    for ev in events:
        kind, p = ev.get("kind"), ev.get("payload") or {}
        if kind == "assistant_text" and p.get("done") and p.get("text") and not p.get("parent_call_id"):
            _session_print(p["text"])
        elif kind == "tool_call" and not p.get("parent_call_id"):
            _session_print(f"tool: {p.get('tool', '?')}")
        elif kind == "ask":
            asks[p.get("message_id", "")] = p.get("body", "")
        elif kind == "user_message" and p.get("source") == "ask_answer":
            answered.add(p.get("message_id", ""))
        elif kind == "turn_done":
            turn_done = True
    sys.stdout.flush()
    return turn_done


def cmd_session_watch(child, until, timeout, after):
    deadline = time.monotonic() + timeout
    asks, answered = {}, set()
    done = False

    def snapshot():
        try:
            status, body = _call("GET", _child_path(child), deadline=deadline)
        except _NET_ERRORS:
            return None
        if 400 <= status < 500:
            _sfail("watch", _http_failure(status, f"{SERVER_HTTP}{_child_path(child)}", body))
        return _json_of(body) if status == 200 else None

    def show_state(info, allow_terminal=True):
        if info is None:
            return False
        # New peers provide the authoritative set, including asks preceding the tail.
        if "open_asks" in info:
            open_asks = [(q.get("message_id", ""), q.get("body", ""))
                         for q in info.get("open_asks") or [] if isinstance(q, dict)]
        else:
            # Old peers: only replayed events can establish an open ask. Drain all pages first.
            open_asks = [(mid, text) for mid, text in asks.items() if mid not in answered]
        if open_asks:
            mid, text = open_asks[0]
            _session_print(f"ask [{mid}]: {text}")
            sys.stdout.flush()
            return True
        failed = _child_failed(info) if allow_terminal else None
        if failed:
            _session_failed(failed)
        if allow_terminal and info.get("lifecycle") == "ended":
            _session_print("the session ended")
            return True
        return False

    # Check status before establishing the tail, so a preexisting question is not lost.
    while time.monotonic() < deadline:
        info = snapshot()
        if info is not None:
            if show_state(info, allow_terminal=after is None):
                return
            break
        _session_pause(deadline, 2)
    if after is None:
        while time.monotonic() < deadline:
            try:
                status, body = _call("GET", _child_path(child, "/events?before_seq=0&limit=1"), deadline=deadline)
            except _NET_ERRORS:
                status, body = None, b""
            if status is not None and 400 <= status < 500:
                _sfail("watch", _http_failure(status, f"{SERVER_HTTP}{_child_path(child)}", body))
            if status == 200:
                evs = _json_of(body).get("events") or []
                after = evs[-1]["seq"] if evs else 0
                break
            _session_pause(deadline, 2)
    after = after or 0
    while time.monotonic() < deadline:
        wait = max(0, min(25, int(deadline - time.monotonic())))
        try:
            status, body = _call("GET", _child_path(child, f"/events?after_seq={after}&wait={wait}"),
                                 timeout=wait + 10, deadline=deadline)
        except _NET_ERRORS:
            status, body = None, b""
        if status is not None and 400 <= status < 500:
            _sfail("watch", _http_failure(status, f"{SERVER_HTTP}{_child_path(child)}", body))
        if status == 200:
            data = _json_of(body)
            evs = data.get("events") or []
            if evs:
                next_after = max(after, max(int(e.get("seq", 0)) for e in evs))
                done = _watch_print(evs, asks, answered) or done
                stopped = _runtime_stopped(evs)
                if stopped:
                    _session_failed(stopped)
                advanced = next_after > after
                after = next_after
                if data.get("has_more") and advanced:
                    continue
            # Recheck before exposing an event ask: it may already have been answered.
            # Also catches a question arriving between the initial snapshot and the tail.
            info = snapshot()
            if info is not None:
                if show_state(info):
                    return
                if done and until == "turn":
                    return
            _session_pause(deadline, 0.05 if info is not None else 2)
        else:
            _session_pause(deadline, 2)
    _still_waiting(f"blerg-runner session watch {child} --after {after}")


def cmd_session(args):
    sub = args.session_cmd
    if sub == "start":
        cmd_session_start(args)
    elif sub == "wait":
        _wait_request(args.request_id, args.timeout)
    elif sub == "list":
        cmd_session_list()
    elif sub == "send":
        cmd_session_send(args.child, args.text)
    elif sub == "model":
        cmd_session_model(args.child, args.model, args.effort)
    elif sub == "rename":
        cmd_session_rename(args.child, args.title)
    elif sub == "interrupt":
        cmd_session_interrupt(args.child)
    elif sub == "upload":
        cmd_session_upload(args.child, args.file)
    elif sub == "files":
        cmd_session_files(args.child)
    elif sub == "download":
        cmd_session_download(args.child, args.target, args.out)
    elif sub == "events":
        cmd_session_events(args.child, args.after)
    elif sub == "watch":
        cmd_session_watch(args.child, args.until, args.timeout, args.after)
    elif sub == "result":
        cmd_session_result(args.child)
    elif sub == "stop":
        cmd_session_stop(args.child)
    elif sub == "discard":
        cmd_session_discard(args.child)


