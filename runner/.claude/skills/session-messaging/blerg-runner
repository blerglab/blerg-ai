            card = args.card_id if args.card_id else ("" if args.card else None)
            cmd_publish(args.path, name=args.name, card=card)
        elif args.cmd == "update":
            cmd_update(args.text)
        elif args.cmd == "ask":
            cmd_ask(args.text, timeout_seconds=args.timeout)
        elif args.cmd == "note":
            cmd_note(args.text)
        return

    # ── board commands — all require board auth ────────────────────────────────
    if not _board_configured():
        _board_noop_notice()
        sys.exit(0)

    if args.cmd == "board":
        if args.board_cmd == "show":
            cmd_board_show(args.board)
        elif args.board_cmd == "order":
            cmd_board_order(args.board)

    elif args.cmd == "column":
        if args.col_cmd == "add":
            cmd_column_add(args.board, args.name, after=args.after,
                           terminal=args.terminal)
        elif args.col_cmd == "rename":
            cmd_column_rename(args.col, args.name)
        elif args.col_cmd == "move":
            cmd_column_move(args.col, after=args.after, before=args.before)
        elif args.col_cmd == "set":
            cmd_column_set(args.col, args.terminal)
        elif args.col_cmd == "rm":
            cmd_column_rm(args.col)

    elif args.cmd == "ticket":
        if args.ticket_cmd == "list":
            cmd_ticket_list(
                args.board,
                column=args.column,
                tags=args.tags,
                priority=args.priority,
                size=args.size,
                ready=args.ready,
                limit=args.limit,
                cursor=args.cursor,
            )
        elif args.ticket_cmd == "get":
            cmd_ticket_get(args.id)
        elif args.ticket_cmd == "create":
            repos = [r.strip() for r in args.repos.split(",")] if args.repos else None
            cmd_ticket_create(
                args.board,
                args.title,
                body=args.body,
                repos=repos,
                column=args.column,
                tags=args.tags,
                priority=args.priority,
                size=args.size,
            )
        elif args.ticket_cmd == "update":
            repos = [r.strip() for r in args.repos.split(",")] if args.repos else None
            cmd_ticket_update(
                args.id,
                title=args.title,
                body=args.body,
                add_tags=args.add_tags,
                rm_tags=args.rm_tags,
                add_repos=args.add_repos,
                rm_repos=args.rm_repos,
                repos=repos,
                priority=args.priority,
                size=args.size,
            )
        elif args.ticket_cmd == "move":
            cmd_ticket_move(args.id, args.column, after=args.after, before=args.before)
        elif args.ticket_cmd == "split":
            cmd_ticket_split(args.id, args.titles)
        elif args.ticket_cmd == "dep":
            if args.dep_cmd == "add":
                cmd_ticket_dep_add(args.id, args.on)
            elif args.dep_cmd == "rm":
                cmd_ticket_dep_rm(args.id, args.on)
        elif args.ticket_cmd == "archive":
            cmd_ticket_archive(args.id)

    elif args.cmd == "tag":
        if args.tag_cmd == "list":
            cmd_tag_list(args.board)


if __name__ == "__main__":
    main()
