# Compiled binaries (a blerg-core binary was once committed by accident).
/blerg-core
/core/blerg-core

# The built daemon binary (install/desktop/daemon/install.sh builds it here).
/bin/

# Secrets and local configuration: never commit these.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*.kubeconfig

# Working notes from agent sessions (plans, ledgers, reports).
.superpowers/
docs/superpowers/

# Local tooling state and per-machine settings.
.claude/worktrees/
.claude/settings.local.json
.envrc

# More credential and key material.
*.crt
*.jks
credentials*.json
kubeconfig

# The runner's default data directory when BLERG_RUNNER_DATA_DIR is unset (a dev `go run`).
/runner/data/

# Local databases.
*.sqlite
*.db

# Checkout-local frontend test caches (dependencies may be a shared symlink).
/.cache/

# Build output and dependencies.
node_modules/
dist/
# the chat package's packed tarball and manifest (built, served by the runner)
dist-packages/

# Video pipeline output (takes, finished videos, voice-over cache): never committed.
/video/out/

# Native workspace security gate evidence and private temporary caches.
/workspace-macos-evidence/

# Per-worktree frontend optimizer and TypeScript caches.
.cache/

# Local pane-system validation evidence and required viewport captures.
/.pane-validation/
/.pane-shots/

# Local session-tab validation evidence and viewport captures.
/.tab-validation/
/.tab-shots/

# Local launch-sheet validation evidence and viewport captures.
/.launch-shots/
