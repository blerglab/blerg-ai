def cmd_tag_list(board_id):
    """Print distinct sorted tags across all (non-archived) board tickets."""
    board_id = board_id or BOARD_ID
    board = _board_get(f"/api/boards/{board_id}")
    ticket_ids = [t["id"] for t in board.get("tickets") or []]

    tag_set = set()
    for tid in ticket_ids:
        detail = _board_get(f"/api/tickets/{tid}")
        for tag in (detail.get("tags") or []):
            tag_set.add(tag)

    if not tag_set:
        print("(no tags)")
    else:
        for tag in sorted(tag_set):
            print(tag)


