# ── ticket subcommands ────────────────────────────────────────────────────────

def cmd_ticket_list(board_id, column=None, tags=None, priority=None,
                    size=None, ready=False, limit=None, cursor=None):
    board_id = board_id or BOARD_ID
    params = {}
    if column:
        # Resolve column name to id if needed.
        params["column"] = _resolve_column(column) if not _is_uuid(column) else column
    if tags:
        # urllib.parse.urlencode handles repeatable params via a list of pairs.
        pass
    if priority:
        params["priority"] = priority
    if size:
        params["size"] = size
    if ready:
        params["ready"] = "true"
    if limit is not None:
        params["limit"] = str(limit)
    if cursor:
        params["cursor"] = cursor

    parts = list(params.items())
    for tag in (tags or []):
        parts.append(("tag", tag))

    qs = ("?" + urllib.parse.urlencode(parts)) if parts else ""
    result = _board_get(f"/api/boards/{board_id}/tickets{qs}")
    tickets = result.get("tickets") or []
    next_cur = result.get("next_cursor") or ""

    if not tickets:
        print("(no tickets)")
    else:
        for t in tickets:
            prio = t.get("priority", "")
            cid = t.get("column_id") or "—"
            print(f"[{prio}] {t['title']}  ({t['id']})  col:{cid}")

    if next_cur:
        print(f"\nNext cursor: {next_cur}")


def cmd_ticket_get(ticket_arg):
    tid = _resolve_ticket(ticket_arg)
    t = _board_get(f"/api/tickets/{tid}")
    print(f"Ticket: {t.get('title', '?')}  ({t.get('id', '?')})")
    if t.get("body"):
        print(f"\n{t['body']}")
    print(f"\nPriority: {t.get('priority', '?')}  Size: {t.get('size') or '—'}")
    print(f"Column:   {t.get('column_id') or '—'}")
    tags = t.get("tags") or []
    if tags:
        print(f"Tags:     {', '.join(tags)}")
    repos = t.get("repos") or []
    if repos:
        print(f"Repos:    {', '.join(repos)}")
    deps = t.get("depends_on") or []
    if deps:
        print(f"Depends:  {', '.join(deps)}")
    blocks = t.get("blocks") or []
    if blocks:
        print(f"Blocks:   {', '.join(blocks)}")


def cmd_ticket_create(board_id, title, body=None, repos=None, column=None,
                      tags=None, priority=None, size=None):
    board_id = board_id or BOARD_ID
    payload = {"title": title}
    if body is not None:
        payload["body"] = body
    if repos:
        payload["repos"] = repos
    if column is not None:
        cid = _resolve_column(column) if not _is_uuid(column) else column
        payload["column_id"] = cid
    if tags:
        payload["tags"] = tags
    if priority:
        payload["priority"] = priority
    if size:
        payload["size"] = size
    t = _board_post(f"/api/boards/{board_id}/tickets", payload)
    print(f"Ticket created: {t.get('title', '?')}  ({t.get('id', '?')})")


def cmd_ticket_update(ticket_arg, title=None, body=None,
                      add_tags=None, rm_tags=None,
                      add_repos=None, rm_repos=None,
                      repos=None, priority=None, size=None):
    tid = _resolve_ticket(ticket_arg)
    payload = {}
    if title is not None:
        payload["title"] = title
    if body is not None:
        payload["body"] = body
    if add_tags:
        payload["add_tags"] = add_tags
    if rm_tags:
        payload["rm_tags"] = rm_tags
    if add_repos:
        payload["add_repos"] = add_repos
    if rm_repos:
        payload["rm_repos"] = rm_repos
    if repos is not None:
        payload["repos"] = repos
    if priority is not None:
        payload["priority"] = priority
    if size is not None:
        payload["size"] = size
    t = _board_patch(f"/api/tickets/{tid}", payload)
    print(f"Ticket updated: {t.get('title', '?')}  ({t.get('id', '?')})")


def cmd_ticket_move(ticket_arg, column, after=None, before=None):
    tid = _resolve_ticket(ticket_arg)
    cid = _resolve_column(column) if not _is_uuid(column) else column
    payload = {"column_id": cid}
    if after is not None:
        after_id = _resolve_ticket(after) if not _is_uuid(after) else after
        payload["after"] = after_id
    if before is not None:
        before_id = _resolve_ticket(before) if not _is_uuid(before) else before
        payload["before"] = before_id
    t = _board_patch(f"/api/tickets/{tid}", payload)
    print(f"Ticket moved: {t.get('title', '?')}  ({t.get('id', '?')})")


def cmd_ticket_split(ticket_arg, titles):
    tid = _resolve_ticket(ticket_arg)
    result = _board_post(f"/api/tickets/{tid}/split", {"titles": titles})
    new_tickets = result.get("tickets") or []
    print(f"Ticket split into {len(new_tickets)} ticket(s):")
    for t in new_tickets:
        print(f"  {t.get('title', '?')}  ({t.get('id', '?')})")


def cmd_ticket_dep_add(ticket_arg, on_arg):
    tid = _resolve_ticket(ticket_arg)
    dep_id = _resolve_ticket(on_arg)
    _board_post(f"/api/tickets/{tid}/dependencies",
                {"depends_on_ticket_id": dep_id})
