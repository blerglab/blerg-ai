def cmd_ticket_dep_rm(ticket_arg, on_arg):
    tid = _resolve_ticket(ticket_arg)
    dep_id = _resolve_ticket(on_arg)
    _board_delete(f"/api/tickets/{tid}/dependencies/{dep_id}")
    print(f"Dependency removed: {tid} no longer depends on {dep_id}")


def cmd_ticket_archive(ticket_arg):
    tid = _resolve_ticket(ticket_arg)
    _board_post(f"/api/tickets/{tid}/archive", {})
    print(f"Ticket archived: {tid}")


