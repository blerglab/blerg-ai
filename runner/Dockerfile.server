# Stage 1: Build Go binary
# Built from a repo-root context so the `replace github.com/blerglab/blerg-ai/contracts
# => ../contracts` in runner/go.mod resolves against a real sibling checkout.
FROM golang:1.25-bookworm@sha256:3b4a11519ad929d1e1d261a12cff056f0c85b735253d7d861346b9c6f8b36437 AS go-builder
WORKDIR /src
COPY contracts/ /src/contracts/
COPY runner/ /src/runner/
WORKDIR /src/runner
RUN go mod download
ARG VERSION=dev
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags "-X main.version=${VERSION}" -o blerg-runner-server ./cmd/server

# Stage 2: Build frontend
# The web app and the chat package it is built from (@blerglab/chat, packages/chat) are members
# of one npm workspace rooted at the repo, with one lockfile. Every member's package.json has to
# be present for `npm ci`, the board's included; only this app and the package are built. The
# package is also packed into the tarball the runner serves to outside apps (GET /packages/),
# beside its manifest.
FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS frontend-builder
WORKDIR /ws
COPY package.json package-lock.json ./
COPY packages/chat/package.json ./packages/chat/
COPY runner/frontend/package.json ./runner/frontend/
COPY board/web/package.json ./board/web/
RUN npm ci
COPY packages/chat/ ./packages/chat/
COPY runner/frontend/ ./runner/frontend/
# Build-time override for where blerg-core is served from (see
# runner/frontend/src/authClient.ts's coreOrigin). Left empty, the derivation
# covers both shapes this repo ships (k8s apex domain, desktop localhost:8081).
ARG VITE_CORE_URL=""
ARG VITE_CORE_PORT=""
ENV VITE_CORE_URL=$VITE_CORE_URL
ENV VITE_CORE_PORT=$VITE_CORE_PORT
RUN npm run build -w packages/chat \
 && npm run pack:manifest -w packages/chat \
 && npm run build -w runner/frontend

# Stage 3: Final image
FROM gcr.io/distroless/static:nonroot@sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3
WORKDIR /app
COPY --from=go-builder /src/runner/blerg-runner-server ./blerg-runner-server
COPY --from=frontend-builder /ws/runner/frontend/dist ./frontend/dist
COPY --from=frontend-builder /ws/packages/chat/dist-packages ./frontend/dist/packages
EXPOSE 8080
ENTRYPOINT ["./blerg-runner-server"]
