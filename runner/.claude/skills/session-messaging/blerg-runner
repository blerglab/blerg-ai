def _call_full(method, path, payload=None, headers=None, raw=None, timeout=30, deadline=None, retry_no_reply=True):
    """Fixed-server authenticated call. Redirects are refused; deadline includes response reads."""
    global SESSION_TOKEN
    SESSION_TOKEN = _session_token()
    _SESSION_SEEN_TOKENS.add(SESSION_TOKEN)
    url = f"{SERVER_HTTP}{path}"
    hdrs = _headers()
    data = None
    if raw is not None:
        hdrs["Content-Type"] = "application/octet-stream"
        if hasattr(raw, "read"):
            hdrs["Content-Length"] = str(os.fstat(raw.fileno()).st_size)
        data = raw
    elif payload is not None:
        data = json.dumps(payload).encode()
    elif method == "POST":
        data = b"{}"
    hdrs.update(headers or {})
    req = urllib.request.Request(url, data=data, headers=hdrs, method=method)
    try:
        with _session_deadline(deadline):
            if deadline is not None:
                timeout = min(timeout, _session_remaining(deadline))
            opener = _SESSION_DIRECT_OPENER if _direct_host(_host_of(url)) else _SESSION_ENV_OPENER
            try:
                resp = _open(req, timeout=timeout, opener=opener, deadline=deadline, retry_no_reply=retry_no_reply)
            except urllib.error.HTTPError as exc:
                resp = exc
            with resp:
                return resp.code, _session_read(resp, deadline), resp.headers
    except Exception as exc:
        # Proxy and network errors can contain addresses or credentials. Never echo them.
        raise _RequestError(_safe_reason(exc)) from None


def _call(method, path, payload=None, headers=None, raw=None, timeout=30, deadline=None):
    status, body, _ = _call_full(method, path, payload, headers, raw, timeout, deadline)
    return status, body


def _json_of(body):
    try:
        out = json.loads(body)
    except (ValueError, TypeError):
        return {}
    return out if isinstance(out, dict) else {}


def _sfail(cmd, msg, code=1):
    _eprint(_session_text(f"blerg-runner session {cmd}: {msg}"))
    sys.exit(code)


def _sess_path(suffix=""):
    return f"/api/sessions/{urllib.parse.quote(SESSION_ID, safe='')}/children{suffix}"


def _child_path(child, suffix=""):
    return _sess_path("/" + urllib.parse.quote(child, safe="") + suffix)


def _sess_do(cmd, method, path, payload=None, headers=None, raw=None, timeout=30, ok=(200, 201, 202)):
    """A call whose failure ends the command: any status outside ok, or no reply at all."""
    url = f"{SERVER_HTTP}{path}"
    try:
        status, body, hdrs = _call_full(method, path, payload, headers, raw, timeout)
    except _NET_ERRORS as exc:
        _sfail(cmd, _conn_failure(url, exc))
    if status not in ok:
        line = _http_failure(status, url, body)
        wait = hdrs.get("Retry-After") if hdrs is not None else None
        if status == 429 and wait:
            line += f"; retry after {_redact(wait)[:10]}s"
        _sfail(cmd, line)
    return status, body


def _hhmm(stamp):
    """A server timestamp as the local clock time, hh:mm; the text itself when it does not parse."""
    import datetime
    try:
        when = datetime.datetime.fromisoformat(str(stamp).replace("Z", "+00:00"))
        return when.astimezone().strftime("%H:%M")
    except ValueError:
        return str(stamp)


def _clock(stamp):
    import datetime
    try:
        when = datetime.datetime.fromisoformat(str(stamp).replace("Z", "+00:00"))
        return when.astimezone().strftime("%I:%M %p").lstrip("0")
    except ValueError:
        return str(stamp)


def _budget_line(eng):
    """`claude  5h 62% used, resets 4:10 PM · 7d 31%`, `hermes  local (runs on your hardware)`."""
    name = eng.get("engine", "?")
    wins = [w for w in (eng.get("windows") or []) if isinstance(w, dict) and w.get("id") != "capped"]
    if not eng.get("available", True):
        return f"{name}  not installed on this daemon"
    parts = []
    for i, w in enumerate(wins):
        pct = w.get("used_percent", 0)
        pct = int(pct) if float(pct) == int(pct) else round(float(pct), 1)
        text = f"{w.get('id', '?')} {pct}%"
        if i == 0:
            text += " used"
            if w.get("resets_at"):
                text += f", resets {_clock(w['resets_at'])}"
        parts.append(text)
    line = " · ".join(parts)
    if not line:
        line = eng.get("note") or ("local (runs on your hardware)" if eng.get("local") else "usage unknown")
    if eng.get("capped_until"):
        line += f" · capped until {_clock(eng['capped_until'])}"
    return f"{name}  {line}"


def cmd_budget(as_json=False, runtime=None):
    query = f"?runtime={urllib.parse.quote(runtime, safe='')}" if runtime else ""
    status, body = _sess_do("budget", "GET", f"/api/sessions/{urllib.parse.quote(SESSION_ID, safe='')}/budget{query}")
    data = _json_of(body)
    if as_json:
        _session_print_json(data)
        return
    engines = data.get("engines") or []
    if not engines:
        _session_print(data.get("note") or "no engines reported")
        return
    for eng in engines:
        _session_print(_budget_line(eng))


_BOARD_LEVEL_LABELS = {"read": "Read", "file": "File without asking", "full": "Full"}


def _child_board_arg(value):
    """--board <name|id>:<level>: a board this session has access to, passed to the child at a level no higher than its own."""
    board, sep, level = (value or "").rpartition(":")
    board, level = board.strip(), level.strip().lower()
    if not sep or not board or level not in _BOARD_LEVEL_LABELS:
        raise argparse.ArgumentTypeError(
            f"{_redact(value)[:80]!r}: give <board>:<level>, the board's name or id and read, file or full (for example Blerg:full)")
    return {"board": board, "level": level}


def _boards_line(boards):
    parts = []
    for b in boards or []:
        if isinstance(b, dict):
            name = _session_text(b.get("name") or b.get("board") or "?")
            parts.append(f"{name} · {_BOARD_LEVEL_LABELS.get(b.get('level'), _session_text(b.get('level') or '?'))}")
    return ", ".join(parts)


def _started_lines(child, via, plugins, budget):
