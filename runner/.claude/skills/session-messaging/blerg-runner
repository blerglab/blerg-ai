def _still_waiting(cmd_line):
    _session_print(f"still waiting — run: {cmd_line}")
    sys.stdout.flush()
    sys.exit(3)


def _fail_if_child_failed(child, deadline):
    """After a start: a child that has already failed (its runtime stopped at once) says so."""
    try:
        status, body = _call("GET", _child_path(child), deadline=deadline)
    except _NET_ERRORS:
        return
    if status == 200:
        info = _json_of(body)
        failed = _child_failed(info)
        if failed:
            _session_failed(failed)


def _wait_request(request_id, timeout=SESSION_DEFAULT_TIMEOUT, deadline=None):
    """Wait for a decision AND a start receipt; an allowed request may still be starting."""
    path = f"/api/delegation-requests/{urllib.parse.quote(request_id, safe='')}"
    url = f"{SERVER_HTTP}{path}"
    deadline = deadline if deadline is not None else time.monotonic() + timeout
    while time.monotonic() < deadline:
        wait = max(0, min(25, int(deadline - time.monotonic())))
        try:
            status, body = _call("GET", f"{path}?wait={wait}", timeout=wait + 10, deadline=deadline)
        except _NET_ERRORS:
            status, body = None, b""
        if status is not None and status != 200:
            if status < 500:
                _sfail("wait", _http_failure(status, url, body))
            status = None
        if status == 200:
            data = _json_of(body)
            st = data.get("status")
            if st == "allowed":
                if data.get("child_session_id"):
                    _session_print(f"started {data['child_session_id']}")
                    _fail_if_child_failed(data["child_session_id"], deadline)
                    return
                if data.get("start_error"):
                    _sfail("wait", f"the person allowed it, but the session did not start: {data['start_error']}")
            if st == "denied":
                _sfail("wait", "the person denied it", code=2)
            if st == "expired":
                _sfail("wait", "nobody answered; ask again with a new start", code=3)
        _session_pause(deadline, 2 if status is None else 0.05)
    _still_waiting(f"blerg-runner session wait {request_id}")


def _timeout_arg(value):
    return max(1, min(SESSION_MAX_TIMEOUT, int(value)))


def cmd_session_start(args):
    if args.prompt_file and args.prompt:
        _sfail("start", "give the prompt as an argument or with --prompt-file, not both", code=2)
    prompt = _read_prompt_file(args.prompt_file) if args.prompt_file else args.prompt
    if not prompt or not prompt.strip():
        _sfail("start", "a prompt is required (an argument or --prompt-file)", code=2)
    if not args.repo and not args.no_repo and not getattr(args, "all_repos", False):
        _sfail("start", "give --repo <member> (repeatable), --all-repos, or --no-repo", code=2)
    body = {"prompt": prompt}
    for key in ("engine", "model", "effort", "runtime", "title"):
        if getattr(args, key):
            body[key] = getattr(args, key)
    if args.no_repo and (args.repo or getattr(args, "all_repos", False)) or getattr(args, "all_repos", False) and args.repo:
        _sfail("start", "choose --repo, --all-repos or --no-repo", code=2)
    if args.repo:
        repos = args.repo if isinstance(args.repo, list) else [args.repo]
        if len(repos) > 20 or len(set(repos)) != len(repos):
            _sfail("start", "select at most 20 distinct repository members", code=2)
        if len(repos) == 1:
            body["repo"] = repos[0]
        else:
            body["repos"] = repos
    if getattr(args, "all_repos", False):
        body["all_repos"] = True
    if args.no_repo:
        body["no_repo"] = True
    if args.keep_running:
        body["keep_running"] = True
    if getattr(args, "board", None):
        body["boards"] = args.board
    import uuid
    key = args.idempotency_key or uuid.uuid4().hex
    _eprint(f"idempotency key: {key}")
    url = f"{SERVER_HTTP}{_sess_path()}"
    deadline = time.monotonic() + args.timeout
    retry_hint = f"repeat the same blerg-runner session start with --idempotency-key {key}"
    last = None
    for attempt in range(SESSION_NET_RETRIES + 1):
        if time.monotonic() >= deadline:
            _still_waiting(retry_hint)
        try:
            # This loop retries a connection that got no reply itself (same key), so _open does not too.
            status, reply, rhdrs = _call_full("POST", _sess_path(), body, headers={"Idempotency-Key": key}, timeout=60,
                                              deadline=deadline, retry_no_reply=False)
            break
        except _NET_ERRORS as exc:
            last = exc
            if time.monotonic() >= deadline:
                _still_waiting(retry_hint)
            if attempt < SESSION_NET_RETRIES:
                _session_pause(deadline, 0.5 * (attempt + 1))
    else:
        _sfail("start", _conn_failure(url, last) + f"; run the same start again with --idempotency-key {key}")
    data = _json_of(reply)
    if status == 201:
        _started_lines(data.get("child") or {}, data.get("via"), data.get("plugins"), data.get("budget"))
        return
    if status not in (200, 202):
        line = _http_failure(status, url, reply)
        if status == 429 and rhdrs.get("Retry-After"):
            line += f"; retry after {_redact(rhdrs['Retry-After'])[:10]}s"
        if status == 422 and _MODEL_PROBLEM.search(line):
            line += "\n  `blerg-runner models` lists the models a child can run, with display names and routing ids"
        _sfail("start", line)
    request_id = data.get("request_id")
    if not request_id:
        _sfail("start", "unexpected reply from the server (no request id)")
    st = data.get("status") or "pending"
    if st == "allowed" and data.get("child_session_id"):
        _session_print(f"started {data['child_session_id']}")
        return
    _session_print(f"request {request_id}")
    sys.stdout.flush()
    if st == "pending":
        exp = f", expires {_hhmm(data['expires_at'])}" if data.get("expires_at") else ""
        _eprint(f"waiting for the person to approve (request {request_id}{exp})")
    if args.no_wait:
        return
    _wait_request(request_id, args.timeout, deadline=deadline)


def _read_prompt_file(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read()
    except OSError as exc:
        _sfail("start", f"cannot read {path}: {os.strerror(exc.errno or 0).lower() or 'error'}", code=2)


def _quoted_title(title, limit=200):
    """A session title as it may reach an agent: one line, no control, bidi or zero-width characters
    (str.isprintable is false for them), cut to limit, and quoted, so another session's title can
    never read as a line of Blerg's own output."""
    text = title if isinstance(title, str) else ""
    text = " ".join("".join(c if c.isprintable() else " " for c in text).split())
    if len(text) > limit:
        text = text[:limit - 1] + "…"
    return json.dumps(text, ensure_ascii=False)


