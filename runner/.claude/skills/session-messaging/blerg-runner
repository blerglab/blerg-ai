def _board_configured():
    return bool(SERVER_HTTP and BOARD_ID and BOARD_TOKEN)


def _board_noop_notice():
    print(
        "blerg-runner: board not configured "
        "(BLERG_RUNNER_SERVER_HTTP/BLERG_RUNNER_BOARD_ID/BLERG_RUNNER_BOARD_TOKEN absent) "
        "— skipping.",
        file=sys.stderr,
    )


def _board_headers():
    return {
        "Authorization": f"Bearer {BOARD_TOKEN}",
        "Content-Type": "application/json",
    }


def _board_get(path, timeout=30):
    """GET with board auth; exit on HTTP error."""
    url = f"{SERVER_HTTP}{path}"
    req = urllib.request.Request(url, headers=_board_headers(), method="GET")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read())
    except urllib.error.HTTPError as exc:
        body = exc.read().decode(errors="replace")
        try:
            msg = json.loads(body).get("error") or body
        except Exception:
            msg = body
        print(f"blerg-runner: HTTP {exc.code}: {msg}", file=sys.stderr)
        sys.exit(1)
    except urllib.error.URLError as exc:
        print(f"blerg-runner: connection error to {url}: {exc.reason}", file=sys.stderr)
        sys.exit(1)


def _board_post(path, payload, timeout=30):
    """POST JSON with board auth; return parsed response body."""
    url = f"{SERVER_HTTP}{path}"
    data = json.dumps(payload).encode()
    req = urllib.request.Request(url, data=data, headers=_board_headers(), method="POST")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read()
            return json.loads(raw) if raw else {}
    except urllib.error.HTTPError as exc:
        body = exc.read().decode(errors="replace")
        try:
            msg = json.loads(body).get("error") or body
        except Exception:
            msg = body
        print(f"blerg-runner: HTTP {exc.code}: {msg}", file=sys.stderr)
        sys.exit(1)
    except urllib.error.URLError as exc:
        print(f"blerg-runner: connection error to {url}: {exc.reason}", file=sys.stderr)
        sys.exit(1)


def _board_patch(path, payload, timeout=30):
    """PATCH JSON with board auth; return parsed response body."""
    url = f"{SERVER_HTTP}{path}"
    data = json.dumps(payload).encode()
    req = urllib.request.Request(url, data=data, headers=_board_headers(), method="PATCH")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read()
            return json.loads(raw) if raw else {}
    except urllib.error.HTTPError as exc:
