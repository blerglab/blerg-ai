def _mcp_redacted_value(value, depth=0):
    # Redact string values before serializing, so header redaction cannot eat
    # JSON delimiters or corrupt the stdio framing.
    if depth > 64:
        raise ValueError('reply nesting exceeds limit')
    if isinstance(value, str):
        return _redact(value)
    if isinstance(value, dict):
        return {key: _mcp_redacted_value(item, depth + 1) for key, item in value.items()}
    if isinstance(value, list):
        return [_mcp_redacted_value(item, depth + 1) for item in value]
    return value


def cmd_session_mcp():
    """Bounded stdio transport for the fixed session tools: ticket filing and plugin requests
    (approval-gated) and board access (checked by the runner on every call)."""
    global SESSION_TOKEN
    maximum = 256 * 1024
    for raw in iter(lambda: sys.stdin.buffer.readline(maximum + 1), b''):
        request_id = None
        response = None
        try:
            if len(raw) > maximum:
                while raw and not raw.endswith(b'\n'):
                    raw = sys.stdin.buffer.readline(maximum + 1)
                raise ValueError('oversized message')
            request = json.loads(raw)
            if not isinstance(request, dict):
                raise ValueError('invalid request')
            request_id = request.get('id')
            if request_id is None:
                continue  # MCP notifications have no response and need no credential.
            if isinstance(request_id, bool) or not isinstance(request_id, (str, int)) or len(str(request_id)) > 128:
                request_id = None
                raise ValueError('invalid request id')
            method = request.get('method')
            if method not in ('initialize', 'ping', 'tools/list', 'tools/call'):
                response = {'error': {'code': -32601, 'message': 'Unknown Blerg session method'}}
            elif method == 'tools/call' and (not isinstance(request.get('params'), dict) or request['params'].get('name') not in ('blerg_ticket_file', 'blerg_request_plugin', 'blerg_board')):
                response = {'error': {'code': -32602, 'message': 'Only Blerg ticket filing, plugin requests and board access are available'}}
            else:
                SESSION_TOKEN = _session_token()  # Token rotation must work without restarting MCP.
                if not SERVER_HTTP or not SESSION_ID or not SESSION_TOKEN:
                    raise ValueError('session tools are not configured')
                url = f"{SERVER_HTTP}/api/sessions/{urllib.parse.quote(SESSION_ID, safe='')}/filing-tools"
                req = urllib.request.Request(url, data=json.dumps(request).encode(), method='POST',
                                             headers={'Authorization': 'Bearer ' + SESSION_TOKEN,
                                                      'Content-Type': 'application/json', 'Accept': 'application/json'})
                with _open(req, timeout=30, allow_redirects=False) as reply:
                    body = reply.read(1024 * 1024 + 1)
                    if len(body) > 1024 * 1024 or 'application/json' not in reply.headers.get('Content-Type', ''):
                        raise ValueError('invalid session tool reply')
                response = json.loads(body)
                if not isinstance(response, dict) or response.get('id') != request_id or response.get('jsonrpc') != '2.0':
                    raise ValueError('invalid session tool reply')
        except (ValueError, TypeError, KeyError, AttributeError, RecursionError):
            response = {'error': {'code': -32600, 'message': 'Invalid or unavailable Blerg session tool request'}}
        except _NET_ERRORS:
            response = {'error': {'code': -32000, 'message': 'Blerg session tools are temporarily unavailable'}}
        response.update(jsonrpc='2.0', id=request_id)
        try:
            for field in ("result", "error"):
                if field in response:
                    response[field] = _mcp_redacted_value(response[field])
        except (ValueError, RecursionError):
            response = {"jsonrpc": "2.0", "id": request_id, "error": {"code": -32600, "message": "Invalid Blerg session tool reply"}}
        print(json.dumps(response), flush=True)


