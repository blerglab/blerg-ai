    sys.exit(1)


def _gateway_tool(name, arguments, timeout=30):
    """Use only the server-issued per-board gateway grant, or the runner with the session token,
    never a Core or board token of the agent's own."""
    if BOARD_VIA_SESSION:
        output = _session_board_request("POST", "board-tools", {"board": BOARD_ID, "tool": name, "arguments": arguments}, timeout)
        return _board_tool_value(name, output)
    request = {"jsonrpc": "2.0", "id": 1, "method": "tools/call",
               "params": {"name": name, "arguments": arguments}}
    req = urllib.request.Request(BOARD_GATEWAY_URL, data=json.dumps(request).encode(),
                                 headers=_board_headers(), method="POST")
    try:
        with _open(req, timeout=timeout, allow_redirects=False) as resp:
            raw = resp.read(2 * 1024 * 1024 + 1)
        if len(raw) > 2 * 1024 * 1024:
            _board_refused("board reply exceeds 2 MiB")
        result = json.loads(raw)
        if result.get("error"):
            _board_refused("board gateway: " + str(result["error"]))
        if not isinstance(result, dict) or result.get("id") != 1:
            _board_refused("invalid board gateway reply")
        return _board_tool_value(name, result["result"])
    except urllib.error.HTTPError as exc:
        _eprint(f"blerg-runner: {_http_failure(exc.code, BOARD_GATEWAY_URL, exc.read(65536))}")
        sys.exit(1)
    except _NET_ERRORS as exc:
        _eprint(f"blerg-runner: {_conn_failure(BOARD_GATEWAY_URL, exc)}")
        sys.exit(1)
    except (ValueError, KeyError, TypeError, AttributeError, RecursionError):
        _board_refused("invalid board gateway reply")


def _board_tool_value(name, output):
    """The JSON value a board tool's MCP result carries, checked for the shape the tool returns."""
    try:
        if output.get("isError"):
            _board_refused("board gateway: " + str(output.get("content", [])))
        texts = [c["text"] for c in output["content"] if c.get("type") == "text"]
        value = json.loads("".join(texts))
        if name in ("blerg_card_search", "blerg_column_list"):
            if value is None:
                return []
            if not isinstance(value, list) or not all(isinstance(item, dict) for item in value):
                _board_refused("invalid board gateway reply")
        elif not isinstance(value, dict):
            _board_refused("invalid board gateway reply")
        return value
    except (ValueError, KeyError, TypeError, AttributeError, RecursionError):
        _board_refused("invalid board gateway reply")


def _selected_board(board_id):
    if board_id != BOARD_ID:
        if BOARD_VIA_SESSION:
            _board_refused("one board per command: name it first, e.g. `blerg-runner ticket list <board>`")
        _board_refused("this session is limited to its selected board")


def _gateway_cards(query="", **filters):
    cards = _gateway_tool("blerg_card_search", {"board_id": BOARD_ID, "query": query,
                                               "limit": 100, **filters}) or []
    if not isinstance(cards, list):
        _board_refused("invalid board gateway card list")
    if len(cards) >= 100:
        _eprint("blerg-runner: results may be incomplete (board search limit: 100); narrow the search")
    return cards


def _gateway_card(card_id):
    card = _gateway_tool("blerg_card_get", {"card_id": card_id})
    _selected_board(card.get("board_id"))
    return card


def _gateway_board_request(method, path, payload, timeout):
    """Translate the legacy CLI vocabulary without widening the gateway allowlist."""
    url = urllib.parse.urlsplit(path)
    parts = url.path.strip("/").split("/")
    params = urllib.parse.parse_qs(url.query)
    if len(parts) >= 3 and parts[:2] == ["api", "boards"]:
        _selected_board(parts[2])
        if method == "GET" and len(parts) == 3:
            board = _gateway_tool("blerg_board_get", {"board_id": BOARD_ID}, timeout)
            board["columns"] = _gateway_tool("blerg_column_list", {"board_id": BOARD_ID}, timeout) or []
            board["tickets"] = _gateway_cards()
            return board
        if method == "GET" and len(parts) == 4 and parts[3] == "tickets":
            if params.get("cursor") or params.get("ready"):
                _board_refused("cursor and ready filters are unavailable for selected boards")
            cards = _gateway_cards(**({"priority": params["priority"][0]} if "priority" in params else {}))
            for key, field in (("column", "column_id"), ("size", "size")):
                if key in params:
                    cards = [c for c in cards if c.get(field) == params[key][0]]
            for tag in params.get("tag", []):
                cards = [c for c in cards if tag in (c.get("tags") or [])]
            if "limit" in params:
                cards = cards[:max(0, int(params["limit"][0]))]
            return {"tickets": cards}
        if method == "POST" and len(parts) == 4 and parts[3] == "tickets":
            result = _gateway_tool("blerg_card_create", {"board_id": BOARD_ID, **payload}, timeout)
            if not isinstance(result.get("card"), dict):
                _board_refused("board gateway did not return a created card")
            return result["card"]
    if len(parts) == 3 and parts[:2] == ["api", "tickets"]:
        card_id = parts[2]
        if method == "GET":
            return _gateway_card(card_id)
        if method == "PATCH":
            args = dict(payload)
            card = _gateway_card(card_id)
            args.update(card_id=card_id, if_match=card["version"])
            if "column_id" in args:
                if "after" in args:
                    _board_refused("move --after is unavailable for selected boards; use --before")
                if "before" in args:
                    _gateway_card(args["before"])
                    args["before_card_id"] = args.pop("before")
                return _gateway_tool("blerg_card_move", args, timeout)
            for field in ("tags", "repos"):
                add, remove = args.pop("add_" + field, []), args.pop("rm_" + field, [])
                if add or remove:
                    args[field] = list(dict.fromkeys([v for v in args.get(field, card.get(field) or []) if v not in remove] + add))
            return _gateway_tool("blerg_card_update", args, timeout)
    _board_refused("this action is unavailable through board access (a selected-board grant or the session's Permissions)")


# ── id-or-name resolution ─────────────────────────────────────────────────────

_UUID_RE = re.compile(
    r'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$',
    re.IGNORECASE,
)


def _is_uuid(s):
    return bool(_UUID_RE.match(s))


def _fetch_board(board_id=None):
    """GET /api/boards/{id}; returns the parsed board JSON."""
    bid = board_id or BOARD_ID
    return _board_get(f"/api/boards/{bid}")


def _resolve_column(name_or_id, board_id=None):
    """Return a column id; resolve name against the board if not a UUID."""
    if _is_uuid(name_or_id):
        return name_or_id
    board = _fetch_board(board_id)
    matches = [c for c in board.get("columns", []) if c["name"] == name_or_id]
    if len(matches) == 0:
        print(f'blerg-runner: column not found: "{name_or_id}"', file=sys.stderr)
        sys.exit(1)
    if len(matches) > 1:
        print(
            f'error: ambiguous name "{name_or_id}" ({len(matches)} matches); use id',
            file=sys.stderr,
        )
        sys.exit(1)
    return matches[0]["id"]


def _resolve_ticket(name_or_id, board_id=None):
    """Return a ticket id; resolve title against the board's tickets if not a UUID."""
    if _is_uuid(name_or_id):
        return name_or_id
    if BOARD_GATEWAY_URL or BOARD_VIA_SESSION:
        _selected_board(board_id or BOARD_ID)
        candidates = _gateway_cards(query=name_or_id)
        if len(candidates) >= 100:
            _board_refused("too many matching cards; use an id")
    else:
        candidates = _fetch_board(board_id).get("tickets", [])
    matches = [t for t in candidates if t["title"] == name_or_id]
    if len(matches) == 0:
        print(f'blerg-runner: ticket not found: "{name_or_id}"', file=sys.stderr)
        sys.exit(1)
    if len(matches) > 1:
        print(
            f'error: ambiguous name "{name_or_id}" ({len(matches)} matches); use id',
            file=sys.stderr,
        )
        sys.exit(1)
    return matches[0]["id"]


