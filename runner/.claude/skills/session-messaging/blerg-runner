TOKEN_REVOKED_HINT = "token revoked or expired — restart the session or wait for a refreshed token"


# ── HTTP: every request goes through _open ────────────────────────────────────
#
# The Blerg server and board are usually on this machine or the compose network (http://localhost:…,
# http://blerg-runner:8080): those are dialled directly, never through a proxy, because a corporate
# proxy Docker or the shell put in the environment cannot reach them. Any other host (a remote
# cluster) keeps honoring the environment's proxy variables. A failure is reported by
# _http_failure / _conn_failure: the status, the server's sentence and error id, the address
# (without any user:password), and for a connection error which proxy variables are set, by NAME
# only (a value can hold a password).

_PROXY_VARS = ("HTTP_PROXY", "http_proxy", "HTTPS_PROXY", "https_proxy", "ALL_PROXY", "all_proxy",
               "NO_PROXY", "no_proxy")

# The exceptions a request can end in besides a reply: urllib's own, and the socket errors
# http.client raises while reading the reply (a connection the server reset or closed).
_NET_ERRORS = (urllib.error.URLError, OSError, http.client.HTTPException)


def _host_of(url):
    try:
        return (urllib.parse.urlsplit(url).hostname or "").lower()
    except ValueError:
        return ""


def _direct_host(host):
    """Whether host is dialled without a proxy: loopback, or a single-label name (blerg-runner,
    localhost), which only this machine or its container network can resolve."""
    if not host:
        return False
    if host == "localhost" or host.endswith(".localhost"):
        return True
    try:
        return ipaddress.ip_address(host).is_loopback
    except ValueError:
        pass
    return "." not in host


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    # Authenticated runner/board endpoints return their answer directly. A
    # redirect must never forward a session credential to a different target.
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def _claude_sandbox_proxy():
    """Claude Code's own sandbox proxy, when this command runs inside Claude Code's sandbox; else None.

    Claude Code's sandbox (bubblewrap on Linux, Seatbelt on macOS) gives its commands no direct route
    to this machine's localhost: everything goes through a proxy of its own on a loopback port, named
    in http_proxy, which lets through only the hosts allowed in its settings (the daemon allows the
    runner's host and port for the session). Its NO_PROXY names localhost, so a local runner address
    has to be sent to that proxy explicitly (_SandboxAwareOpener, only for the session's own runner
    and board, and only after a direct connect failed). Recognized by SANDBOX_RUNTIME=1, which Claude Code sets,
    and a plain-http proxy on a loopback address with a port."""
    if os.environ.get("SANDBOX_RUNTIME") != "1":
        return None
    for name in ("http_proxy", "HTTP_PROXY"):
        value = os.environ.get(name, "").strip()
        if not value:
            continue
        try:
            parts = urllib.parse.urlsplit(value)
            port = parts.port
        except ValueError:
            return None
        host = (parts.hostname or "").lower()
        loopback = host == "localhost"
        if not loopback:
            try:
                loopback = ipaddress.ip_address(host).is_loopback
            except ValueError:
                loopback = False
        if parts.scheme == "http" and loopback and port:
            return value
        return None
    return None


class _SandboxProxyHandler(urllib.request.BaseHandler):
    """Sends every request through one proxy, whatever NO_PROXY says (urllib's ProxyHandler would
    skip it for localhost). Used only for Claude Code's sandbox proxy (_claude_sandbox_proxy)."""

    handler_order = 100  # before the HTTP handlers, as urllib's ProxyHandler

    def __init__(self, proxy):
        parts = urllib.parse.urlsplit(proxy)
        self._hostport = f"{parts.hostname}:{parts.port}"
        self._auth = None
        if parts.username is not None:
            user_pass = f"{urllib.parse.unquote(parts.username)}:{urllib.parse.unquote(parts.password or '')}"
            self._auth = "Basic " + base64.b64encode(user_pass.encode()).decode("ascii")

    def _via_proxy(self, req):
        if self._auth:
            req.add_header("Proxy-authorization", self._auth)
        req.set_proxy(self._hostport, "http")
        return None  # the HTTP handlers send it, to the proxy

    http_open = _via_proxy
    https_open = _via_proxy


def _blerg_endpoints():
    """The (host, port) pairs of the runner and board addresses this session was given: the only
    destinations ever sent through Claude Code's sandbox proxy."""
    out = set()
    for name in ("BLERG_RUNNER_SERVER_HTTP", "BLERG_RUNNER_SERVER_URL", "BLERG_BOARD_URL",
                 "BLERG_RUNNER_BOARD_GATEWAY_URL"):
        value = os.environ.get(name, "").strip()
        if not value:
            continue
        try:
            parts = urllib.parse.urlsplit(value)
            port = parts.port or {"http": 80, "ws": 80, "https": 443, "wss": 443}.get(parts.scheme)
        except ValueError:
            continue
        if parts.hostname and port:
            out.add((parts.hostname.lower(), port))
    return out


class _SandboxAwareOpener:
    """Inside Claude Code's sandbox: a local address is dialled directly first; only when that
    connect is refused or not permitted (the sandbox has no route to this machine's localhost) and
    the address is this session's own runner or board is the request sent through the sandbox's
    proxy. A loopback proxy that is not Claude's, or any other destination, never gets the request."""

    def __init__(self, proxy):
        self._direct = urllib.request.build_opener(urllib.request.ProxyHandler({}), _NoRedirect())
        self._proxied = urllib.request.build_opener(
            _SandboxProxyHandler(proxy), urllib.request.ProxyHandler({}), _NoRedirect())
        self._allowed = _blerg_endpoints()

    def _allowed_target(self, url):
        try:
            parts = urllib.parse.urlsplit(url)
            port = parts.port or {"http": 80, "https": 443}.get(parts.scheme)
        except ValueError:
            return False
        return ((parts.hostname or "").lower(), port) in self._allowed

    def open(self, req, timeout=None):
        try:
            return self._direct.open(req, timeout=timeout)
        except urllib.error.URLError as exc:
            if not isinstance(exc.reason, (ConnectionRefusedError, PermissionError)) \
                    or not self._allowed_target(req.full_url):
                raise
        return self._proxied.open(req, timeout=timeout)


_CLAUDE_SANDBOX_PROXY = _claude_sandbox_proxy()
if _CLAUDE_SANDBOX_PROXY:
    _DIRECT_OPENER = _SandboxAwareOpener(_CLAUDE_SANDBOX_PROXY)
else:
    _DIRECT_OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}), _NoRedirect())
_ENV_OPENER = urllib.request.build_opener(_NoRedirect())


class _RequestError(urllib.error.URLError):
    """A request that got no reply. Its reason is words this command chose, never an exception's
    own text: urllib and http.client quote the URL or the proxy variable they choose to fail on,
    and a proxy variable can hold a password."""


def _safe_reason(exc):
    """Why a request got no reply, in fixed words (the exception's class, an errno, an SSL reason
    code), never the exception's text."""
    import socket
    import ssl
    reason = exc
    while isinstance(reason, urllib.error.URLError) and isinstance(reason.reason, BaseException):
        reason = reason.reason
    if isinstance(reason, urllib.error.URLError):
        # A URLError with a text reason: our own (_RequestError), or urllib's, which may quote a value.
        return reason.reason if isinstance(reason, _RequestError) else "the request could not be made"
    if isinstance(reason, (TimeoutError, socket.timeout)):
        return "timed out"
    if isinstance(reason, socket.gaierror):
        return "the host name could not be resolved"
    if isinstance(reason, ConnectionRefusedError):
        return "connection refused"
    if isinstance(reason, ConnectionResetError):
        return "connection reset by the other side"
    if isinstance(reason, BrokenPipeError):
        return "the connection was closed while sending"
    if isinstance(reason, http.client.RemoteDisconnected):
        return "the other side closed the connection without answering"
    if isinstance(reason, ssl.SSLError):
        code = getattr(reason, "reason", None)
        code = code if isinstance(code, str) and re.fullmatch(r"[A-Z0-9_]{1,64}", code) else ""
        return "the TLS handshake failed" + (f" ({code})" if code else "")
    if isinstance(reason, OSError) and isinstance(reason.errno, int) and reason.errno > 0:
        return os.strerror(reason.errno).lower()
    if isinstance(reason, (ValueError, UnicodeError, http.client.InvalidURL)):
        return "a proxy variable or the address is not a valid URL"
    return f"the request failed ({reason.__class__.__name__})"


_DIRECT_NO_REDIRECT = _DIRECT_OPENER
_ENV_NO_REDIRECT = _ENV_OPENER


# How long a request keeps retrying an outage, counted from its first attempt and including the
# time later attempts spend waiting for a reply: no retry starts after this, and a retry's socket
# timeout is cut to what is left of it.
RETRY_BUDGET = 30
# A refused or reset connection is retried for less time: behind a Service with a ready pod it
# lasts only while the endpoints change (a second or two); a server that stays down is reported
# sooner.
NO_REPLY_RETRY_BUDGET = 10
# The shortest attempt worth starting: with less of the budget left, the outage is reported.
_RETRY_MIN_ATTEMPT = 1
# Replies that mean a gateway, ingress or the server is briefly away (a rolling deploy); their body,
# HTML or not, is the gateway's page and never the answer. Every other reply, 2xx and 4xx included,
# is the server's answer: an HTML file a person attached is served with 200 and is never retried.
_OUTAGE_STATUSES = (502, 503, 504)


def _no_reply_is_outage(exc):
    """A connection the server refused or dropped before answering (a pod that is restarting, reached
    directly with no gateway in front to answer 502). Never a timeout: the request may have run."""
    reason = exc
    while isinstance(reason, urllib.error.URLError) and isinstance(reason.reason, BaseException):
        reason = reason.reason
    return isinstance(reason, (ConnectionRefusedError, ConnectionResetError))


def _open(req, timeout, allow_redirects=True, opener=None, deadline=None, retry_no_reply=True):
    """urlopen for every request this command makes: direct for a local host, else through the
    environment's proxy (if any).

    A replayable idempotent request (or one with an Idempotency-Key) that meets an outage, a
    502/503/504 reply or a refused or reset connection, is retried with backoff for at most
    RETRY_BUDGET seconds in all (NO_REPLY_RETRY_BUDGET for a connection that got no reply; never,
    with retry_no_reply False, for a caller with its own loop), or until deadline (a
    time.monotonic() value) if sooner. An error
    reply raises HTTPError as urlopen does; ANY other failure raises _RequestError with fixed words
    (_safe_reason), so nothing a proxy variable holds can reach the output.
    """
    retryable = req.get_method() in ("GET", "HEAD", "OPTIONS", "PUT", "DELETE", "TRACE") or bool(req.get_header("Idempotency-key"))
    data = req.data
    offset = None
    if hasattr(data, "read"):
        try:
            offset = data.tell()
            data.seek(offset)
        except (AttributeError, OSError, ValueError):
            retryable = False
    started = time.monotonic()
    stop = started + RETRY_BUDGET
    if deadline is not None:
        stop = min(stop, deadline)
    delay = 1
    attempt_timeout = timeout
    try:
        if opener is None:
            opener = _DIRECT_OPENER if _direct_host(_host_of(req.full_url)) else _ENV_OPENER
            if not allow_redirects:
                opener = _DIRECT_NO_REDIRECT if _direct_host(_host_of(req.full_url)) else _ENV_NO_REDIRECT
        while True:
            failure = None
            try:
                reply = opener.open(req, timeout=attempt_timeout)
            except urllib.error.HTTPError as exc:
                reply = exc
            except Exception as exc:  # noqa: BLE001 - reported below in fixed words
                if not (retryable and retry_no_reply and _no_reply_is_outage(exc)):
                    raise
                reply, failure = None, exc
                stop = min(stop, started + NO_REPLY_RETRY_BUDGET)
            if reply is not None and reply.code not in _OUTAGE_STATUSES:
                if isinstance(reply, urllib.error.HTTPError):
                    raise reply
                return reply
            # An outage: retry while the budget leaves room for the pause and an attempt.
            pause = min(delay, max(0, stop - time.monotonic()))
            if not retryable or stop - time.monotonic() - pause < _RETRY_MIN_ATTEMPT:
                if failure is not None:
                    raise failure
                if isinstance(reply, urllib.error.HTTPError):
                    raise reply
                return reply
            if reply is not None:
                reply.close()
            time.sleep(pause)
            delay = min(delay * 2, 8)
            attempt_timeout = min(timeout, stop - time.monotonic()) if timeout is not None else stop - time.monotonic()
            if offset is not None:
                data.seek(offset)
    except urllib.error.HTTPError:
        raise
    except Exception as exc:  # noqa: BLE001 - fixed words keep proxy credentials out of output
        raise _RequestError(_safe_reason(exc)) from None


# user:password@ in an address, up to the LAST @ of the authority (a password may hold an @).
_USERINFO_RE = re.compile(r"(?i)\b([a-z][a-z0-9+.-]*://)[^/?#\s]*@")
# The value of an Authorization or Proxy-Authorization header, whatever its scheme, to the line end.
_AUTH_HEADER_RE = re.compile(r"(?im)\b((?:proxy-)?authorization)\s*[:=]\s*[^\r\n]*")
# A credential after its scheme word, outside a header (a reply that echoed one into its text).
_AUTH_SCHEME_RE = re.compile(r"(?i)\b(bearer|basic|digest|negotiate)(\s+|=)[A-Za-z0-9._~+/=:-]{4,}")
# Control characters (ANSI escapes and the like) in a reply a proxy wrote.
_CONTROL_RE = re.compile(r"[\x00-\x08\x0b-\x1f\x7f-\x9f]")


def _secrets():
    """The credential values this command knows, longest first: replaced wherever they appear."""
    vals = {SESSION_TOKEN, os.environ.get("BLERG_RUNNER_SESSION_TOKEN", ""), BOARD_TOKEN, DAEMON_TOKEN,
            os.environ.get("BLERG_RUNNER_DAEMON_TOKEN", ""), CARD_BOARD_TOKEN}
    return sorted((v.strip() for v in vals if v and len(v.strip()) >= 4), key=len, reverse=True)


def _redact(text):
    """text as it may be printed: no control characters, no user:password@ in an address, no
    Authorization or Proxy-Authorization value, no credential after Bearer/Basic/Token/..., and
    none of this session's or the daemon's tokens. Every failure line goes through it, and a
    reply is redacted BEFORE it is cut short, so a cut can never leave part of a secret."""
    text = _CONTROL_RE.sub("", str(text))
    for secret in _secrets():
        text = text.replace(secret, "[token]")
    text = _USERINFO_RE.sub(r"\1", text)
    text = _AUTH_HEADER_RE.sub(r"\1: [redacted]", text)
    return _AUTH_SCHEME_RE.sub(r"\1 [redacted]", text)


_scrub = _redact


def _eprint(text):
    """A failure line, redacted, to stderr."""
    print(_redact(text), file=sys.stderr)


def _safe_url(url):
    """The address as it may be printed: no user:password, no token."""
    return _scrub(url)


def _reply_detail(body):
    """(sentence, error id) of an error reply: the runner's JSON {error, error_id} (no id from a
    server older than 0.2.1), or the raw text of one that is not JSON (a proxy's page, the board's
    plain-text refusals), on one line and trimmed."""
    text = body.decode("utf-8", errors="replace") if isinstance(body, (bytes, bytearray)) else (body or "")
    try:
        j = json.loads(text)
    except ValueError:
        j = None
    if isinstance(j, dict) and isinstance(j.get("error"), str) and j["error"].strip():
        eid = j.get("error_id")
        eid = _redact(eid) if isinstance(eid, str) and re.fullmatch(r"[A-Za-z0-9_-]{1,64}", eid) else ""
        return _cut(" ".join(_redact(j["error"]).split())), eid
    # Redacted first, with its line breaks (a header runs to its line's end), then cut.
    one = " ".join(_redact(text).split())
    if one[:15].lower().startswith(("<!doctype html", "<html")):
        return "the server answered with a web page, not an API reply (is the address right?)", ""
    return _cut(one), ""


def _cut(text, n=200):
    """text cut to n characters; only ever applied to text already redacted."""
    return text if len(text) <= n else text[:n - 1] + "…"


def _http_where(code, url, error_id=""):
    """`HTTP 500 from <url>; error id ab12cd34`: what goes with a refusal's sentence."""
    out = f"HTTP {code} from {_safe_url(url)}"
    if error_id:
        out += f"; error id {error_id}"
    return out


def _http_failure(code, url, body):
    """One line for an error reply: the server's sentence, the status, the address, the error id."""
    if _token_revoked(code, body):
        return f"{TOKEN_REVOKED_HINT} ({_http_where(code, url)})"
    detail, eid = _reply_detail(body)
    return f"{detail or 'no reason given'} ({_http_where(code, url, eid)})"


def _reason(exc):
    return _safe_reason(exc)


def _proxy_note(url):
    """Which proxy variables are set (names only) and whether url's host goes around them."""
    names = [n for n in _PROXY_VARS if os.environ.get(n, "").strip()]
    host = _host_of(url) or "the host"
    if not names:
        return "no proxy variables are set"
    note = "proxy variables set: " + ", ".join(names)
    if _direct_host(host) and _CLAUDE_SANDBOX_PROXY:
        return note + f"; {host} is dialled directly, then through Claude Code's sandbox proxy, which must allow it"
    if _direct_host(host):
        return note + f"; {host} is dialled directly, not through a proxy"
    try:
        covered = bool(urllib.request.proxy_bypass_environment(host))
    except Exception:  # noqa: BLE001 - a diagnostic must never fail the report
        covered = False
    return note + f"; {host} is {'' if covered else 'not '}covered by NO_PROXY"


def _conn_failure(url, exc):
    """One line for a request that got no reply: the address, why, and the proxy picture."""
    return f"connection error to {_safe_url(url)}: {_reason(exc)} ({_proxy_note(url)})"


def _token_revoked(code, body):
    """Whether an error reply is the server saying this session's token was revoked or expired."""
    if code != 401:
        return False
    try:
        return json.loads(body).get("code") == "session_token_revoked"
    except (ValueError, AttributeError):
        return False


def _http_error_line(code, url, body):
    return f"blerg-runner: {_http_failure(code, url, body)}"


def _post(path, payload, timeout=30):
    """POST JSON payload; return parsed response body.  Exits on any error."""
    url = f"{SERVER_HTTP}{path}"
    data = json.dumps(payload).encode()
    req = urllib.request.Request(url, data=data, headers=_headers(), method="POST")
    try:
        with _open(req, timeout=timeout) as resp:
            return json.loads(resp.read())
    except urllib.error.HTTPError as exc:
        _eprint(_http_error_line(exc.code, url, exc.read()))
        sys.exit(1)
    except _NET_ERRORS as exc:
        _eprint(f"blerg-runner: {_conn_failure(url, exc)}")
        sys.exit(1)


def _get(path, timeout=30):
    """GET; return parsed response body.

    On HTTP error: prints message to stderr and exits 1.
    On network/timeout error: raises urllib.error.URLError so the poll loop
    can decide whether to retry or treat as fatal.
    """
    url = f"{SERVER_HTTP}{path}"
    req = urllib.request.Request(url, headers=_headers(), method="GET")
    try:
        with _open(req, timeout=timeout) as resp:
            return json.loads(resp.read())
    except urllib.error.HTTPError as exc:
        _eprint(_http_error_line(exc.code, url, exc.read()))
        sys.exit(1)
    except (OSError, http.client.HTTPException) as exc:
        if isinstance(exc, urllib.error.URLError):
            raise
        # A reply cut short (reset, timeout while reading) is a network error like any other.
        raise urllib.error.URLError(exc) from exc
    # urllib.error.URLError (including socket.timeout) propagates to caller


