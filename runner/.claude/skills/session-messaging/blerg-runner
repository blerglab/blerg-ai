_SESSION_DIRECT_OPENER = _DIRECT_OPENER
_SESSION_ENV_OPENER = _ENV_OPENER
_SESSION_SEEN_TOKENS = {SESSION_TOKEN}


def _session_remaining(deadline):
    remaining = deadline - time.monotonic()
    if remaining <= 0:
        raise _RequestError("command timeout")
    return remaining


def _session_pause(deadline, seconds):
    time.sleep(max(0, min(seconds, deadline - time.monotonic())))


@contextlib.contextmanager
def _session_deadline(deadline):
    """Bound the complete POSIX CLI request, including DNS and trickled headers.

    Blerg's Linux/macOS CLI runs on the main thread. Other Python hosts retain the
    socket/read deadline fallback. Restore an existing handler/timer on every exit.
    """
    if deadline is None or not hasattr(signal, "setitimer") or threading.current_thread() is not threading.main_thread():
        yield
        return
    remaining = _session_remaining(deadline)
    previous_handler = signal.getsignal(signal.SIGALRM)
    previous_timer = signal.getitimer(signal.ITIMER_REAL)
    started = time.monotonic()

    def expired(_signum, _frame):
        raise TimeoutError("command timeout")

    signal.signal(signal.SIGALRM, expired)
    try:
        signal.setitimer(signal.ITIMER_REAL, remaining)
        yield
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, previous_handler)
        if previous_timer[0] > 0:
            left = max(0.000001, previous_timer[0] - (time.monotonic() - started))
            signal.setitimer(signal.ITIMER_REAL, left, previous_timer[1])


def _session_read(resp, deadline):
    if deadline is None:
        return resp.read()
    parts = []
    while True:
        remaining = _session_remaining(deadline)
        # urllib's timeout is an inactivity timeout. Reset it to the remaining command
        # budget for each read so a slow stream cannot restart the full allowance.
        stream = resp
        for _ in range(5):
            sock = getattr(stream, "_sock", None)
            if sock is not None:
                sock.settimeout(remaining)
                break
            stream = getattr(stream, "fp", None) or getattr(stream, "raw", None)
            if stream is None:
                break
        reader = getattr(resp, "read1", resp.read)
        part = reader(65536)
        _session_remaining(deadline)
        if not part:
            return b"".join(parts)
        parts.append(part)


def _session_text(text):
    text = str(text)
    for secret in sorted((v for v in _SESSION_SEEN_TOKENS if v and len(v) >= 4), key=len, reverse=True):
        text = text.replace(secret, "[token]")
    return _redact(text)


def _session_print(text):
    print(_session_text(text))


def _session_json_value(value):
    if isinstance(value, str):
        return _session_text(value)
    if isinstance(value, list):
        return [_session_json_value(item) for item in value]
    if isinstance(value, dict):
        return {_session_text(key): _session_json_value(item) for key, item in value.items()}
    return value


def _session_print_json(value, pretty=False):
    print(json.dumps(_session_json_value(value), indent=2 if pretty else None, ensure_ascii=False))


