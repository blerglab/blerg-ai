def cmd_session_download(child, target, out):
    items = _child_files(child)
    hit = next((it for it in items if it.get("id") == target), None)
    if hit is None:
        named = [it for it in items if it.get("name") == target]
        if named:
            hit = max(named, key=lambda it: it.get("version", 0))
    if hit is None:
        _sfail("download", f"no file {target!r} (try: blerg-runner session files {child})")
    path = _child_path(child, "/artifacts/" + urllib.parse.quote(hit["id"], safe="") + "/download")
    _, data = _sess_do("download", "GET", path, timeout=120)
    dest = out or _safe_local_name(hit.get("name"))
    try:
        if not out or os.path.isdir(out):
            dest, fh = _open_new(out or ".", _safe_local_name(hit.get("name")))
        else:
            fd = os.open(dest, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o644)
            fh = os.fdopen(fd, "wb")
        with fh:
            fh.write(data)
    except OSError as exc:
        _sfail("download", f"cannot write {dest}: {os.strerror(exc.errno or 0).lower() or 'error'}")
    _session_print(f"saved {dest} ({_fmt_size(len(data))})")


