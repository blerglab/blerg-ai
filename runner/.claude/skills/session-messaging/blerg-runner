def cmd_ticket_list(board_id, column=None, tags=None, priority=None,
                    size=None, ready=False, limit=None, cursor=None):
    board_id = board_id or BOARD_ID
    params = {}
    if column:
        # Resolve column name to id if needed.
        params["column"] = _resolve_column(column) if not _is_uuid(column) else column
    if tags:
        # urllib.parse.urlencode handles repeatable params via a list of pairs.
        pass
    if priority:
        params["priority"] = priority
    if size:
        params["size"] = size
    if ready:
        params["ready"] = "true"
    if limit is not None:
        params["limit"] = str(limit)
    if cursor:
        params["cursor"] = cursor

    parts = list(params.items())
    for tag in (tags or []):
        parts.append(("tag", tag))

    qs = ("?" + urllib.parse.urlencode(parts)) if parts else ""
    result = _board_get(f"/api/boards/{board_id}/tickets{qs}")
    tickets = result.get("tickets") or []
    next_cur = result.get("next_cursor") or ""

    if not tickets:
        print("(no tickets)")
    else:
        for t in tickets:
            prio = t.get("priority", "")
            cid = t.get("column_id") or "—"
            print(f"[{prio}] {t['title']}  ({t['id']})  col:{cid}")

    if next_cur:
        print(f"\nNext cursor: {next_cur}")


def _card_address(card):
    """Print a Blerg Board card's address and how to pin it, when the card names its board and
    number. The address is the Board's page for it (inside Blerg); the runner sets it again when
    the card is pinned, so a failed lookup only shortens the line."""
    if not isinstance(card, dict):
        return
    board_id, number = card.get("board_id"), card.get("number")
    if not isinstance(board_id, str) or not re.fullmatch(r"[A-Za-z0-9_-]{1,64}", board_id) or not isinstance(number, int) or number <= 0:
        return
    url = ""
    if SERVER_HTTP and SESSION_ID:
        path = (f"/api/sessions/{urllib.parse.quote(SESSION_ID, safe='')}/board-card-url?"
                + urllib.parse.urlencode({"board": board_id, "number": number}))
        req = urllib.request.Request(SERVER_HTTP + path, headers=_headers(), method="GET")
        try:
            with _open(req, timeout=10, allow_redirects=False) as resp:
                reply = json.loads(resp.read(65536))
            if isinstance(reply, dict) and isinstance(reply.get("url"), str) and reply["url"].startswith(("http://", "https://")):
                url = reply["url"]
        except (urllib.error.HTTPError, ValueError, TypeError) + _NET_ERRORS:
            url = ""
    print(f"Card: {url}" if url else f"Card: #{number} on board {board_id}")
    pin = {"source": "blerg-board", "board_id": board_id, "key": f"#{number}",
           "title": card.get("title") if isinstance(card.get("title"), str) else f"Card #{number}"}
    print("Pin it: echo " + shlex.quote(json.dumps(pin)) + " | blerg-runner pin -")


