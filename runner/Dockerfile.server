# Stage 1: Build Go binary
# Built from a repo-root context so the `replace github.com/blerglab/blerg-ai/contracts
# => ../contracts` in runner/go.mod resolves against a real sibling checkout.
FROM golang:1.27-bookworm@sha256:69a7b9788769bec032d238959b61854e9ae87f57be9029ec04e9885fabf99195 AS go-builder
WORKDIR /src
COPY contracts/ /src/contracts/
COPY runner/ /src/runner/
WORKDIR /src/runner
RUN go mod download
ARG VERSION=dev
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags "-X main.version=${VERSION}" -o blerg-runner-server ./cmd/server

# Stage 2: Build frontend
FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS frontend-builder
WORKDIR /frontend
COPY runner/frontend/package.json runner/frontend/package-lock.json ./
RUN npm ci
COPY runner/frontend/ ./
# Build-time override for where blerg-core is served from (see
# runner/frontend/src/authClient.ts's coreOrigin). Left empty, the derivation
# covers both shapes this repo ships (k8s apex domain, desktop localhost:8081).
ARG VITE_CORE_URL=""
ARG VITE_CORE_PORT=""
ENV VITE_CORE_URL=$VITE_CORE_URL
ENV VITE_CORE_PORT=$VITE_CORE_PORT
RUN npm run build

# Stage 3: Final image
FROM gcr.io/distroless/static:nonroot@sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3
WORKDIR /app
COPY --from=go-builder /src/runner/blerg-runner-server ./blerg-runner-server
COPY --from=frontend-builder /frontend/dist ./frontend/dist
EXPOSE 8080
ENTRYPOINT ["./blerg-runner-server"]
