# ── id-or-name resolution ─────────────────────────────────────────────────────

_UUID_RE = re.compile(
    r'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$',
    re.IGNORECASE,
)


def _is_uuid(s):
    return bool(_UUID_RE.match(s))


def _fetch_board(board_id=None):
    """GET /api/boards/{id}; returns the parsed board JSON."""
    bid = board_id or BOARD_ID
    return _board_get(f"/api/boards/{bid}")


def _resolve_column(name_or_id, board_id=None):
    """Return a column id; resolve name against the board if not a UUID."""
    if _is_uuid(name_or_id):
        return name_or_id
    board = _fetch_board(board_id)
    matches = [c for c in board.get("columns", []) if c["name"] == name_or_id]
    if len(matches) == 0:
        print(f'blerg-runner: column not found: "{name_or_id}"', file=sys.stderr)
        sys.exit(1)
    if len(matches) > 1:
        print(
            f'error: ambiguous name "{name_or_id}" ({len(matches)} matches); use id',
            file=sys.stderr,
        )
        sys.exit(1)
    return matches[0]["id"]


def _resolve_ticket(name_or_id, board_id=None):
    """Return a ticket id; resolve title against the board's tickets if not a UUID."""
    if _is_uuid(name_or_id):
        return name_or_id
    board = _fetch_board(board_id)
    matches = [t for t in board.get("tickets", []) if t["title"] == name_or_id]
    if len(matches) == 0:
        print(f'blerg-runner: ticket not found: "{name_or_id}"', file=sys.stderr)
        sys.exit(1)
    if len(matches) > 1:
        print(
            f'error: ambiguous name "{name_or_id}" ({len(matches)} matches); use id',
            file=sys.stderr,
        )
        sys.exit(1)
    return matches[0]["id"]


