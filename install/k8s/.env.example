# Copy to install/k8s/.env and edit, or export these before running deploy.sh.
# Never commit install/k8s/.env — it may end up holding real secret values
# once you fill in the SECRET_* overrides further down.

# Your own registry (e.g. a local registry add-on, or a LAN registry
# reachable from every node). localhost:32000 is the MicroK8s built-in
# registry convention; change it for k3s/other distros.
REGISTRY=localhost:32000
TAG=latest

# Domain used by the Ingress. Point this at your ingress controller via
# private DNS, or add per-host /etc/hosts entries (see README.md).
DOMAIN=blerg.local

# Optional: name of a cert-manager ClusterIssuer already installed in your
# cluster. When set, deploy.sh requests a TLS cert for the ingress and
# switches BLERG_CORE's return-origin allowlist/audiences to https://. Leave
# unset (the default) to serve plain HTTP, e.g. for a bare self-hosted install.
# CLUSTER_ISSUER=letsencrypt-prod

# Override when TLS is terminated by something other than cert-manager, e.g.
# a fronting proxy. deploy.sh derives this from CLUSTER_ISSUER otherwise.
# SCHEME=https

# Cluster runtime (per-session agent pods) is on by default — deploy.sh builds
# the agent image, creates the blerg-runner-sessions namespace + RBAC, and
# creates the blerg-runner-agent Secret. Users bring their own engine
# credentials in Settings, so no operator secret is required.
# CLUSTER_RUNTIME=off

# Set to 1 if you manage the blerg-runner-agent Secret yourself (sealed
# secrets, external-secrets, ...). deploy.sh then never touches it.
# AGENT_SECRET_EXTERNAL=1

# Optional: set any of these to pin a secret value instead of letting
# deploy.sh generate a random one with `openssl rand`.
# SECRET_POSTGRES_PASSWORD=
# SECRET_BLERG_CORE_REGISTER_KEY=
# SECRET_BLERG_BOARD_SERVICE_KEY=
# SECRET_BLERG_RUNNER_KEY=
# SECRET_BLERG_RUNNER_DAEMON_TOKEN=
# SECRET_ANTHROPIC_API_KEY=
# SECRET_BLERG_CORE_INTERNAL_KEY=
# SECRET_BLERG_CORE_LOCAL_KEY=
# base64 of 32 random bytes; encrypts board automation tokens at rest. Pin only to restore a
# backup — a redeploy keeps the live value, and changing it makes stored tokens unreadable.
# SECRET_BLERG_BOARD_SECRET_KEY=
# SECRET_BLERG_CORE_GITHUB_TOKEN=
# SECRET_BLERG_RUNNER_GITHUB_TOKEN=

# Optional operator-wide credentials for cluster-runtime session pods, written
# into the blerg-runner-agent Secret. Leave them unset unless you want every
# cluster session to fall back to a shared credential — users' own credentials
# from Settings work without any of these. SECRET_ANTHROPIC_API_KEY above is
# reused here too.
# SECRET_CLAUDE_CODE_OAUTH_TOKEN=
# SECRET_BLERG_RUNNER_GIT_TOKEN=
# SECRET_CODEX_AUTH_JSON=
# SECRET_HERMES_ENV_CONTENTS=

# Completion webhooks refuse private/loopback callback targets unless this is
# 1/true. Set it when your public hostnames resolve to a private network (a
# private network behind NAT) — otherwise every callback into that network is refused.
# WEBHOOK_ALLOW_PRIVATE=1
