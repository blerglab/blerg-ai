[Unit]
Description=Blerg runner daemon (drives local claude CLI + tmux for agent sessions)
After=network-online.target

[Service]
Type=simple
ExecStart=__BIN_PATH__
Environment=BLERG_RUNNER_SERVER_URL=__SERVER_URL__
Environment=BLERG_RUNNER_DAEMON_TOKEN=__DAEMON_TOKEN__
Environment=BLERG_RUNNER_REPOS_ROOT=__REPOS_ROOT__
__EXTRA_ENV__
Restart=on-failure
# Stop the daemon first and its engine processes only once it has gone: the daemon records which
# sessions were mid-turn, and an engine that died first would make it record that none were.
KillMode=mixed
RestartSec=5

[Install]
WantedBy=default.target
