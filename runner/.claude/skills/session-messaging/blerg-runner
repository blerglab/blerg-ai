PROGRESS_GUIDE = """Show measured work in the session panel: blerg-runner progress 3/7 "Running checks".
Counts must be whole numbers: 0 <= n <= m <= 1000000 and m >= 1.
The label must be one nonempty line of at most 200 characters.
Use blerg-runner progress --done to finish the last explicit progress bar.
Run inside the current foreground Bash call; background or ended calls cannot report.
Supported engines attribute subagent calls automatically. A Claude shell without its
Blerg hook must be upgraded/restarted; unknown metadata is refused, never guessed.
No progress is inferred from command output. Prefer a plan for work with known steps.
"""


def cmd_progress(counter, label, done=False):
    if done:
        if counter is not None or label is not None:
            _work_fail("progress", "give n/m and a label, or --done, not both")
        body = {"done": True}
    else:
        if counter is None or not re.fullmatch(r"[0-9]{1,7}/[0-9]{1,7}", counter):
            _work_fail("progress", "give whole numbers n/m: 0 <= n <= m <= 1000000 and m >= 1")
        completed, total = (int(value) for value in counter.split("/"))
        if total < 1 or completed > total or total > 1000000:
            _work_fail("progress", "counts must satisfy 0 <= n <= m <= 1000000 and m >= 1")
        label = (label or "").strip()
        if not label or len(label) > 200 or any(ord(ch) < 32 or 127 <= ord(ch) <= 159 or 0xd800 <= ord(ch) <= 0xdfff for ch in label):
            _work_fail("progress", "give one nonempty label of at most 200 characters without control characters")
        body = {"completed": completed, "total": total, "label": label}
    # These are claims, not authority. The daemon resolves them against its
    # current native call/thread ownership; unknown claims are never root scope.
    if "BLERG_RUNNER_PROGRESS_CALL_ID" in os.environ:
        marker = os.environ["BLERG_RUNNER_PROGRESS_CALL_ID"]
        if not _valid_progress_marker(marker):
            _work_fail("progress", "invalid native progress attribution")
        body["call_id"] = marker
    elif any(key in os.environ for key in ("CLAUDECODE", "CLAUDE_CODE_CHILD_SESSION", "CLAUDE_CODE_SESSION_ID", "CLAUDE_CODE_ENTRYPOINT")):
        _work_fail("progress", "this Claude shell has no Blerg progress hook; upgrade/restart the session and run progress inside its current foreground Bash call")
    elif "CODEX_THREAD_ID" in os.environ:
        marker = os.environ["CODEX_THREAD_ID"]
        if not _valid_progress_marker(marker):
            _work_fail("progress", "invalid native progress attribution")
        body["native_thread_id"] = marker
    _work_post("progress", "progress", body, "progress bars")
    print("Progress: done" if done else f"Progress: {completed}/{total} · {label}")


