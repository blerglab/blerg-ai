    pb_create = board_sub.add_parser("create", help="Propose a new board for the person to approve (use when asked to make a board)",
                                     description=BOARD_CREATE_GUIDE, formatter_class=argparse.RawDescriptionHelpFormatter)
    pb_create.add_argument("name", help="The board's name")
    pb_create.add_argument("--repo", dest="repos", action="append", metavar="REPO", help="owner/name or folder; repeat for several (the first is primary)")
    pb_create.add_argument("--template", default=None, help="A board template, such as focus-board")
    pb_create.add_argument("--columns", default=None, metavar="A,B,C", help="Comma-separated column names")
    pb_create.add_argument("--description", default=None, help="What the board is for")
    pb_create.add_argument("--access", choices=("read", "file", "full"), default="full", help="The access you ask for on the new board (default: full)")
    pb_create.add_argument("--idempotency-key", default=None, metavar="KEY", help="Repeat a proposal whose reply was lost")

    pb_order = board_sub.add_parser("order", help="Show board ticket order (ready-first)")
    pb_order.add_argument("board", nargs="?", help="Board id or name (default: the launch board, or the only board given in Permissions)")

    # ── column ─────────────────────────────────────────────────────────────────
    p_col = sub.add_parser("column", help="Column commands")
    col_sub = p_col.add_subparsers(dest="col_cmd", required=True)

    pc_add = col_sub.add_parser("add", help="Add a column to a board")
    pc_add.add_argument("board", nargs="?", help="Board id or name (default: the launch board, or the only board given in Permissions)")
    pc_add.add_argument("--name", required=True, help="Column name")
    pc_add.add_argument("--after", metavar="COL", help="Insert after this column id/name")
    pc_add.add_argument("--terminal", action="store_true", help="Mark as terminal")

    pc_rename = col_sub.add_parser("rename", help="Rename a column")
    pc_rename.add_argument("col", help="Column id or name")
    pc_rename.add_argument("--name", required=True, help="New name")

    pc_move = col_sub.add_parser("move", help="Move a column")
    pc_move.add_argument("col", help="Column id or name")
    pc_move_pos = pc_move.add_mutually_exclusive_group(required=True)
    pc_move_pos.add_argument("--after", metavar="COL", help="Insert after this column")
    pc_move_pos.add_argument("--before", metavar="COL", help="Insert before this column")

    pc_set = col_sub.add_parser("set", help="Set column properties")
    pc_set.add_argument("col", help="Column id or name")
    pc_set_term = pc_set.add_mutually_exclusive_group(required=True)
    pc_set_term.add_argument("--terminal", dest="terminal", action="store_true")
    pc_set_term.add_argument("--no-terminal", dest="terminal", action="store_false")

    pc_rm = col_sub.add_parser("rm", help="Delete a column")
    pc_rm.add_argument("col", help="Column id or name")

    # ── ticket ─────────────────────────────────────────────────────────────────
    p_tick = sub.add_parser("ticket", help="Ticket commands")
    tick_sub = p_tick.add_subparsers(dest="ticket_cmd", required=True)

    tick_sub.add_parser("boards", help="List boards this session's owner can access")
    pt_search = tick_sub.add_parser("search", help="Search a board for duplicates without approval")
    pt_search.add_argument("--board", required=True, help="Target board name or id")
    pt_search.add_argument("--query", required=True, help="Search terms")
    pt_file = tick_sub.add_parser("file", help="Propose a ticket for the person to approve",
                                  description=FILING_GUIDE, formatter_class=argparse.RawDescriptionHelpFormatter)
    pt_file.add_argument("--board", required=True, help="Target board name or id")
    pt_file.add_argument("--title", required=True)
    pt_file.add_argument("--body", required=True)
    pt_file.add_argument("--type", dest="card_type", default=None)
    pt_file.add_argument("--sensitive", action="store_true", help="Restrict reproduction details to board administrators")
    pt_file.add_argument("--repo", dest="target_repos", action="append", help="Target-board repo; repeat for several")

    pt_status = tick_sub.add_parser("status", help="Where a proposal ticket file made stands (0 done, 3 waiting, 4 not done, 5 unknown)")
    pt_status.add_argument("proposal_id", help="The proposal id ticket file printed")
    pt_list = tick_sub.add_parser("list", help="List tickets")
    pt_list.add_argument("board", nargs="?", help="Board id or name (default: the launch board, or the only board given in Permissions)")
    pt_list.add_argument("--column", metavar="COL", help="Filter by column id/name")
    pt_list.add_argument("--tag", dest="tags", action="append", metavar="TAG")
    pt_list.add_argument("--priority", metavar="P")
    pt_list.add_argument("--size", metavar="S")
    pt_list.add_argument("--ready", action="store_true")
    pt_list.add_argument("--limit", type=int, metavar="N")
    pt_list.add_argument("--cursor", metavar="C")

    pt_get = tick_sub.add_parser("get", help="Get a ticket")
    pt_get.add_argument("id", help="Ticket id or title")

    pt_create = tick_sub.add_parser("create", help="Create a ticket")
    pt_create.add_argument("board", nargs="?", help="Board id or name (default: the launch board, or the only board given in Permissions)")
    pt_create.add_argument("--title", required=True)
    pt_create.add_argument("--body", default=None)
    pt_create.add_argument("--repos", metavar="A,B", default=None,
                           help="Comma-separated repo list")
    pt_create.add_argument("--column", metavar="COL", default=None)
    pt_create.add_argument("--tag", dest="tags", action="append", metavar="TAG")
    pt_create.add_argument("--priority", default=None)
    pt_create.add_argument("--size", default=None)

    pt_update = tick_sub.add_parser("update", help="Update a ticket")
    pt_update.add_argument("id", help="Ticket id or title")
    pt_update.add_argument("--title", default=None)
    pt_update.add_argument("--body", default=None)
    pt_update.add_argument("--add-tag", dest="add_tags", action="append", metavar="TAG")
    pt_update.add_argument("--rm-tag", dest="rm_tags", action="append", metavar="TAG")
    pt_update.add_argument("--add-repo", dest="add_repos", action="append", metavar="REPO")
    pt_update.add_argument("--rm-repo", dest="rm_repos", action="append", metavar="REPO")
    pt_update.add_argument("--repos", metavar="A,B", default=None)
    pt_update.add_argument("--priority", default=None)
    pt_update.add_argument("--size", default=None)

    pt_move = tick_sub.add_parser("move", help="Move a ticket to a column")
    pt_move.add_argument("id", help="Ticket id or title")
    pt_move.add_argument("--column", required=True, metavar="COL")
    pt_move_pos = pt_move.add_mutually_exclusive_group()
    pt_move_pos.add_argument("--after", metavar="TICKET")
    pt_move_pos.add_argument("--before", metavar="TICKET")

    pt_split = tick_sub.add_parser("split", help="Split a ticket into multiple")
    pt_split.add_argument("id", help="Ticket id or title")
    pt_split.add_argument("--into", dest="titles", action="append",
                          required=True, metavar="TITLE")

    pt_dep = tick_sub.add_parser("dep", help="Manage ticket dependencies")
    dep_sub = pt_dep.add_subparsers(dest="dep_cmd", required=True)

    pd_add = dep_sub.add_parser("add", help="Add a dependency")
    pd_add.add_argument("id", help="Ticket id or title")
    pd_add.add_argument("--on", required=True, metavar="OTHER",
                        help="Ticket this depends on (id or title)")

    pd_rm = dep_sub.add_parser("rm", help="Remove a dependency")
    pd_rm.add_argument("id", help="Ticket id or title")
    pd_rm.add_argument("--on", required=True, metavar="OTHER",
                       help="Ticket to un-depend on (id or title)")

    pt_archive = tick_sub.add_parser("archive", help="Archive a ticket")
    pt_archive.add_argument("id", help="Ticket id or title")

    # ── tag ────────────────────────────────────────────────────────────────────
    p_tag = sub.add_parser("tag", help="Tag commands")
    tag_sub = p_tag.add_subparsers(dest="tag_cmd", required=True)

    ptag_list = tag_sub.add_parser("list", help="List all distinct tags on a board")
    ptag_list.add_argument("board", nargs="?", help="Board id or name (default: the launch board, or the only board given in Permissions)")

    argv = sys.argv[1:]
    diff_paths = []
    if argv[:1] == ["diff"] and "--" in argv:
        # Paths after -- are paths, whatever they look like; argparse would take them for revisions.
        cut = argv.index("--")
        argv, diff_paths = argv[:cut], argv[cut + 1:]
    if argv[:1] == ["checklist"]:
        # nargs="*" does not resume positional collection after option flags.
        args, remaining = parser.parse_known_args(argv)
        if any(value.startswith("-") for value in remaining):
            parser.error("unrecognized checklist option")
        args.values.extend(remaining)
    else:
        args = parser.parse_args(argv)

    # ── session messaging commands (existing) ──────────────────────────────────
    if args.cmd in ("update", "ask", "note", "publish", "fetch", "files", "unpublish", "review", "topic", "mark", "title",
                    "checklist", "pin", "unpin", "diff", "progress", "request-plugin", "session", "budget", "models") or (args.cmd == "ticket" and args.ticket_cmd in ("boards", "search", "file", "status")) \
            or (args.cmd == "board" and args.board_cmd == "create"):
        if not _configured():
            _noop_notice()
            sys.exit(0)
        if args.cmd == "board":
            cmd_board_create(args.name, repos=args.repos, template=args.template, columns=args.columns,
                             description=args.description, access=args.access, idempotency_key=args.idempotency_key)
        elif args.cmd == "request-plugin":
            cmd_request_plugin(args.name, args.reason)
        elif args.cmd == "ticket":
            if args.ticket_cmd == "boards":
                cmd_ticket_boards()
            elif args.ticket_cmd == "search":
                cmd_ticket_search(args.board, args.query)
            elif args.ticket_cmd == "file":
                cmd_ticket_file(args.board, args.title, args.body, args.card_type, args.sensitive, args.target_repos)
            elif args.ticket_cmd == "status":
                cmd_ticket_status(args.proposal_id)
        elif args.cmd == "review":
            if args.review_cmd == "list":
                cmd_review_list(args.file)
            elif args.review_cmd == "reply":
                cmd_review_reply(entries=args.entries, path=args.reply_file)
            elif args.review_cmd == "request":
                cmd_review_request(args.artifact, args.ask, args.wait, _timeout_arg(args.timeout))
            elif args.review_cmd == "wait":
                cmd_review_wait(args.request_id, _timeout_arg(args.timeout))
            elif args.review_cmd == "status":
                cmd_review_status(args.request_id)
            elif args.review_cmd == "withdraw":
                cmd_review_withdraw(args.request_id)
        elif args.cmd == "session":
            cmd_session(args)
        elif args.cmd == "budget":
            cmd_budget(args.as_json, args.runtime)
        elif args.cmd == "models":
            cmd_models(args.engine, args.runtime)
        elif args.cmd == "diff":
            cmd_diff(args.revs, staged=args.staged, worktree=args.worktree, paths=diff_paths, title=args.title,
                     request_review_ask=args.request_review)
        elif args.cmd == "progress":
            cmd_progress(args.counter, args.label, args.done)
        elif args.cmd == "topic":
            cmd_topic(args.title, args.done, args.commit)
        elif args.cmd == "mark":
            if args.import_file is not None:
                if args.kind or args.text or args.by or args.commit or args.card is not None or args.at:
                    parser.error("mark --import <file> takes no other arguments")
                cmd_mark_import(args.import_file)
            else:
                cmd_mark(args.kind, args.text, args.by, args.commit, args.card, args.at)
        elif args.cmd == "title":
            cmd_title(args.title)
        elif args.cmd == "checklist":
            cmd_checklist(args.op, args.values, args.force_text, args.commit, args.force_id, args.agent_id, args.child_session)
        elif args.cmd == "pin":
            cmd_pin(args.file, args.checklist)
        elif args.cmd == "unpin":
            cmd_unpin(args.target)
        elif args.cmd == "files":
            cmd_files()
        elif args.cmd == "unpublish":
            cmd_unpublish(args.target, version=args.version, all_versions=args.all_versions)
        elif args.cmd == "fetch":
            if not (args.ids or args.all or args.all_versions or args.list_only):
                parser.error("fetch: give attachment ids or names, or --all, or --list")
            cmd_fetch(args.ids, args.all, args.out, args.list_only, args.all_versions)
        elif args.cmd == "publish":
            card = args.card_id if args.card_id else ("" if args.card else None)
            cmd_publish(args.path, name=args.name, card=card, request_review_ask=args.request_review)
        elif args.cmd == "update":
            cmd_update(args.text)
        elif args.cmd == "ask":
            if args.resolve is not None:
                if args.text or args.no_wait:
                    parser.error("ask --resolve <id> takes no question")
                cmd_ask_resolve(args.resolve)
            elif not args.text:
                parser.error("ask: give the question")
            elif args.no_wait:
                cmd_ask_no_wait(args.text)
            else:
                cmd_ask(args.text, timeout_seconds=args.timeout)
        elif args.cmd == "note":
            cmd_note(args.text)
        return

    # ── board commands — all require board auth ────────────────────────────────
    if args.cmd == "board" and args.board_cmd == "access":
        cmd_board_access()
        return
    named_board = getattr(args, "board", None)
    if _board_configured() and named_board and named_board != BOARD_ID and _session_board_available():
        # A board other than the one chosen at launch: the runner, at the level the person gave it.
        args.board = _use_session_board(named_board)
    elif not _board_configured():
        if not _session_board_available():
            _board_noop_notice()
            sys.exit(0)
        # No launch-time board credential: the runner, with the session token, at the level the
        # person gave each board in the session's Permissions.
        chosen = _use_session_board(getattr(args, "board", None))
        if getattr(args, "board", None):
            args.board = chosen

    if args.cmd == "board":
        if args.board_cmd == "show":
            cmd_board_show(args.board)
        elif args.board_cmd == "order":
            cmd_board_order(args.board)

    elif args.cmd == "column":
        if args.col_cmd == "add":
            cmd_column_add(args.board, args.name, after=args.after,
                           terminal=args.terminal)
        elif args.col_cmd == "rename":
            cmd_column_rename(args.col, args.name)
        elif args.col_cmd == "move":
            cmd_column_move(args.col, after=args.after, before=args.before)
        elif args.col_cmd == "set":
            cmd_column_set(args.col, args.terminal)
        elif args.col_cmd == "rm":
            cmd_column_rm(args.col)

    elif args.cmd == "ticket":
        if args.ticket_cmd == "list":
            cmd_ticket_list(
                args.board,
                column=args.column,
                tags=args.tags,
                priority=args.priority,
                size=args.size,
                ready=args.ready,
                limit=args.limit,
                cursor=args.cursor,
            )
        elif args.ticket_cmd == "get":
            cmd_ticket_get(args.id)
        elif args.ticket_cmd == "create":
            repos = [r.strip() for r in args.repos.split(",")] if args.repos else None
            cmd_ticket_create(
                args.board,
                args.title,
                body=args.body,
                repos=repos,
                column=args.column,
                tags=args.tags,
                priority=args.priority,
                size=args.size,
            )
        elif args.ticket_cmd == "update":
            repos = [r.strip() for r in args.repos.split(",")] if args.repos else None
            cmd_ticket_update(
                args.id,
                title=args.title,
                body=args.body,
                add_tags=args.add_tags,
                rm_tags=args.rm_tags,
                add_repos=args.add_repos,
                rm_repos=args.rm_repos,
                repos=repos,
                priority=args.priority,
                size=args.size,
            )
        elif args.ticket_cmd == "move":
            cmd_ticket_move(args.id, args.column, after=args.after, before=args.before)
        elif args.ticket_cmd == "split":
            cmd_ticket_split(args.id, args.titles)
        elif args.ticket_cmd == "dep":
            if args.dep_cmd == "add":
                cmd_ticket_dep_add(args.id, args.on)
            elif args.dep_cmd == "rm":
                cmd_ticket_dep_rm(args.id, args.on)
        elif args.ticket_cmd == "archive":
            cmd_ticket_archive(args.id)

    elif args.cmd == "tag":
        if args.tag_cmd == "list":
            cmd_tag_list(args.board)


if __name__ == "__main__":
    main()
